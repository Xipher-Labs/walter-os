# Walter-OS All-In-One Environment Template
#
# Copy to .env in the repo root and fill in the required values.
#   cp templates/env.all.template .env
#   $EDITOR .env
#
# Required vars are marked [REQUIRED]. Optional vars have sensible defaults.
# Never commit the filled-in .env file.
#
# Refs: docs/specs/phase-w-1-docker-compose.md
# Refs: setup/SERVICES-INVENTORY.md

# =============================================================================
# BOOTSTRAP (5 core vars — the only required inputs for a first run)
# =============================================================================

# Your base domain. All services will be at <service>.${WALTER_DOMAIN}.
# Example: example.com → plane.example.com, grafana.example.com, etc.
WALTER_DOMAIN=                          # [REQUIRED] e.g. example.com

# Admin email for TLS certificates (Caddy ACME) and service notifications.
WALTER_ADMIN_EMAIL=                     # [REQUIRED] e.g. admin@example.com

# Initial admin username for services that support it (Grafana, LiteLLM, etc.)
WALTER_INITIAL_USER=admin              # [REQUIRED] default: admin

# Initial admin password — force-change on first login.
# Must be changed immediately after first login.
WALTER_INITIAL_PASSWORD=               # [REQUIRED] min 12 chars

# Timezone for all services.
# Use TZ database names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
WALTER_TIMEZONE=UTC                    # [REQUIRED] e.g. America/Argentina/Buenos_Aires

# =============================================================================
# SHARED POSTGRES
# =============================================================================

# Password for the `walter` superuser on the shared Postgres instance.
POSTGRES_PASSWORD=                     # [REQUIRED] generate: openssl rand -hex 16

# =============================================================================
# PLANE (project management)
# =============================================================================

PLANE_POSTGRES_USER=plane
PLANE_POSTGRES_PASSWORD=               # [REQUIRED] generate: openssl rand -hex 16
PLANE_POSTGRES_DB=plane

PLANE_RABBITMQ_USER=plane
PLANE_RABBITMQ_PASSWORD=               # [REQUIRED] generate: openssl rand -hex 16
PLANE_RABBITMQ_VHOST=plane

# Django secret key for Plane backend
PLANE_SECRET_KEY=                      # [REQUIRED] generate: openssl rand -base64 48

# Minio (S3-compatible object storage for Plane file uploads)
PLANE_AWS_ACCESS_KEY_ID=minioadmin     # [REQUIRED] change from default
PLANE_AWS_SECRET_ACCESS_KEY=minioadmin # [REQUIRED] change from default
PLANE_S3_BUCKET_NAME=uploads
PLANE_FILE_SIZE_LIMIT=5242880          # bytes — default 5MB

# =============================================================================
# FORGEJO (git hosting)
# =============================================================================

FORGEJO_DB_PASS=                       # [REQUIRED] generate: openssl rand -hex 16

# =============================================================================
# INFISICAL (secrets manager)
# =============================================================================

# CRITICAL: Generate these once. Never change after first run.
# Changing them makes all stored secrets unreadable.
INFISICAL_ENCRYPTION_KEY=              # [REQUIRED] generate: openssl rand -hex 16
INFISICAL_AUTH_SECRET=                 # [REQUIRED] generate: openssl rand -base64 32

INFISICAL_DB_PASS=                     # [REQUIRED] generate: openssl rand -hex 16
INFISICAL_REDIS_PASS=                  # [REQUIRED] generate: openssl rand -hex 16

# =============================================================================
# LITELLM (LLM gateway)
# =============================================================================

LITELLM_MASTER_KEY=sk-                 # [REQUIRED] prefix with sk-
LITELLM_SALT_KEY=                      # [REQUIRED] generate: openssl rand -hex 16
LITELLM_DB_PASS=                       # [REQUIRED] generate: openssl rand -hex 16
LITELLM_UI_PASS=                       # [REQUIRED]

# LLM provider API keys (all optional — only add what you have)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# GRAFANA (dashboards)
# =============================================================================

# Will be set to WALTER_INITIAL_PASSWORD at bootstrap if not specified
GF_ADMIN_PASSWORD=                     # [REQUIRED]

# =============================================================================
# N8N (workflow automation)
# =============================================================================

N8N_PG_PASS=                           # [REQUIRED] generate: openssl rand -hex 16
N8N_ENCRYPTION_KEY=                    # [REQUIRED] generate: openssl rand -hex 32

# =============================================================================
# WIREGUARD (VPN)
# =============================================================================

# Generate password hash: docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'yourpassword'
WG_PASSWORD_HASH=                      # [REQUIRED]

# =============================================================================
# OPTIONAL: TELEGRAM ALERTING
# =============================================================================

WALTER_TELEGRAM_BOT_TOKEN=
WALTER_TELEGRAM_CHAT_ID=

# =============================================================================
# CORE: MARKETING & ANALYTICS
# (Postiz, Metabase, PostHog, Control Tower — always-on as of v0.2.0)
# =============================================================================

# Postiz (social media scheduling)
POSTIZ_PG_PASS=                        # [REQUIRED] generate: openssl rand -hex 16
POSTIZ_JWT_SECRET=                     # [REQUIRED] generate: openssl rand -base64 32
POSTIZ_WEBHOOK_URL=                    # optional — n8n ingest URL

# Metabase (BI dashboards)
METABASE_DB_PASS=                      # [REQUIRED] generate: openssl rand -hex 16

# PostHog (product analytics)
POSTHOG_SECRET=                        # [REQUIRED] generate: openssl rand -hex 32
POSTHOG_DB_PASS=                       # [REQUIRED] generate: openssl rand -hex 16
CLICKHOUSE_PASSWORD=                   # [REQUIRED] generate: openssl rand -hex 16

# Control Tower (Walter Council UI)
# These may already exist in your standalone .env — copy them here.
CONTROL_TOWER_ADMIN_TOKEN=            # [REQUIRED] generate: openssl rand -hex 32
CONTROL_TOWER_AUTH_DISABLED=false     # [OPTIONAL] only works outside NODE_ENV=production
LITELLM_API_KEY=                       # [REQUIRED] LiteLLM master key or virtual key for Control Tower
LITELLM_BASE_URL=http://litellm:4000
# PLANE_API_URL=https://plane.example.com/api/v1   # required for Control Tower; replace example.com with your domain
PLANE_API_TOKEN=                       # [REQUIRED] Plane API token
PLANE_WORKSPACE_SLUG=                  # [REQUIRED] your Plane workspace slug
PLANE_PROJECT_ID=                      # [REQUIRED] Plane project UUID
GRAFANA_URL=http://grafana:3000
GRAFANA_SA_TOKEN=                      # [REQUIRED] Grafana service account token
TAILSCALE_ENFORCE=true
TAILSCALE_CGNAT_CIDR=100.64.0.0/10

# =============================================================================
# OPTIONAL: DESIGN PROFILE (--profile design)
# =============================================================================

PENPOT_DB_PASS=                        # generate: openssl rand -hex 16
PENPOT_SECRET_KEY=                     # [REQUIRED if using design profile] generate: openssl rand -base64 32

# =============================================================================
# OPTIONAL: ASSISTANT PROFILE (--profile assistant)
# =============================================================================

LITELLM_OPENCLAW_KEY=                  # LiteLLM virtual key for OpenClaw
OPENCLAW_TELEGRAM_BOT_TOKEN=
OPENCLAW_OPERATOR_CHAT_ID=
OPENCLAW_GATEWAY_TOKEN=                # [REQUIRED if using assistant profile] generate: openssl rand -hex 32

# =============================================================================
# OPTIONAL: COMMS PROFILE (--profile comms)
# =============================================================================

SYNAPSE_DB_PASS=                       # generate: openssl rand -hex 16
RESEND_API_KEY=                        # Resend API key for Rocketchat email

# =============================================================================
# OPTIONAL: HEADSCALE
# =============================================================================

# Headscale config is file-based (setup/headscale/config.yaml).
# No additional env vars needed — config file references WALTER_DOMAIN.
