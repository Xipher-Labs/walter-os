#!/usr/bin/env bash
# walter — operator's DAILY-DRIVER CLI for Walter-OS.
#
# This is the high-level user-facing binary (new project / ask / pivot /
# deploy / etc.). There is ALSO `bin/walter-os` — the ADMIN binary for
# audit, baseline, profile, secrets, lower-level ops. The two are
# intentionally separate — don't merge them without coordinating the
# CLI surface for both (issue #121).
#
# Quick map:
#   walter     → new project / ask / pivot / deploy / higher-level
#   walter-os  → audit / baseline / profile / lower-level ops
#
# Both have a `doctor` subcommand:
#   walter doctor          operator's install-health check (with --client-only)
#   walter-os doctor       checks the agent contract + symlinks
#
# Usage:
#   walter <command> <subcommand> [args...]
#
# Examples:
#   walter new project hackaton my-app
#   walter new project --interactive
#   walter ask "what agents are blocked"
#   walter explain nanobanana
#   walter pivot
#   walter ai status
#   walter status
#   walter deploy grafana
#   walter alert test
#   walter doctor
#   walter secrets walter-os dev

set -euo pipefail

# Source operator env config if present (paths, tokens, etc.)
[[ -f "$HOME/.config/walter-os/env" ]] && source "$HOME/.config/walter-os/env"

WALTER_OS_HOME="${WALTER_OS_HOME:?WALTER_OS_HOME required — set in personal.env or export. Default: /opt/walter-os}"
WALTER_LIB="${WALTER_OS_HOME}/scripts/walter"

if [[ ! -d "$WALTER_LIB" ]]; then
  echo "✗ Walter library not found at $WALTER_LIB" >&2
  echo "  Run install.sh or set WALTER_OS_HOME." >&2
  exit 2
fi

# Source library helpers
# shellcheck source=/dev/null
source "$WALTER_LIB/lib/log.sh"
# shellcheck source=/dev/null
source "$WALTER_LIB/lib/prompt.sh"

# ---------- dispatch ----------
usage() {
  cat <<'EOF'
walter — Walter-OS operator CLI

Commands:
  new project <type> [name]        Scaffold new project. Types:
                                     projects = software projects you build for yourself
                                     hackaton = short-lived hackathon entries
                                     work     = employer or client projects
                                     personal = non-dev personal life (finance/health)
  new project --interactive        AI-powered project interview (LLM required). Generates
                                     AGENTS.md + spec charter + Plane epic. Add --write to
                                     persist files to disk.
  ask "<question>"                 Ask a natural-language question about Council state.
                                     LLM reads agent status, mode, last-24h spend. (AI required)
  explain <skill>                  Plain-English explanation of a skill/component.
                                     Falls back to raw SKILL.md if AI not configured.
  pivot                            Reconfigure an existing project (requires AGENTS.md in cwd).
                                     Uses project-pivot skill (W-3) or interactive fallback.
  ai status                        Show detected/configured AI providers and routes.
  ai configure --profile <profile> Configure Claude/Codex/Gemini/Ollama capability routing.
  providers configure              Interactive provider choice wizard. Choose LLM,
                                     git, secrets, analytics, search, embeddings
                                     providers and write to providers.yaml + .env.local.
  overlay                          Open ~/.config/walter-os/overlay with configured opener
  status                           Walter-VM service health snapshot
  deploy <service>                 Pull + restart a Walter-VM service
  logs <service> [tail]            Tail logs from a service
  alert <subcmd>                   test | mute <duration>
  audit                            Run daily supply-chain audit
  doctor                           Diagnose install state
  secrets <ws> <env>               Fetch + export secrets from Infisical
  vm <subcmd>                      connect | status | snapshot
  version                          Show walter-os version + git ref
  help                             Show this help

Examples:
  walter new project hackaton afip-categorizer
  walter new project --interactive
  walter ask "what agents are blocked right now"
  walter explain nanobanana
  walter pivot
  walter ai configure --profile mixed
  walter ai status
  walter providers configure
  walter status
  walter deploy grafana
  walter alert test
EOF
}

cmd="${1:-help}"
shift || true

# Universal help for any subcommand: `walter <cmd> -h|--help|help` →
# show the top-level usage. Subcommand scripts that ship their own
# `--help` handler (the ones that need it) get the args passed through.
if [[ "${1:-}" =~ ^(-h|--help|help)$ ]]; then
  case "$cmd" in
    new|status|deploy|logs|alert|doctor|secrets|vm|providers|overlay|ai)
      ;; # subcommand handles its own help
    *)
      usage; exit 0 ;;
  esac
fi

case "$cmd" in
  help|--help|-h)            usage ;;
  version|--version|-v)
    cd "$WALTER_OS_HOME" && git describe --always --dirty 2>/dev/null || echo "unknown"
    ;;

  new)
    sub="${1:-}"; shift || true
    case "$sub" in
      project)
        # Check for --interactive flag anywhere in remaining args
        interactive=false
        for arg in "$@"; do
          [[ "$arg" == "--interactive" ]] && interactive=true
        done
        if [[ "$interactive" == "true" ]]; then
          exec bash "$WALTER_LIB/subcommands/new-project-interactive.sh" "$@"
        else
          exec bash "$WALTER_LIB/subcommands/new-project.sh" "$@"
        fi
        ;;
      help|--help|-h|"")
        cat <<'NEW_USAGE'
Usage: walter new <subcommand> [args]

Subcommands:
  project <type> [name]        Scaffold a new project repo + Plane + Infisical + Obsidian.
                               Types: projects | hackaton | work | personal
                               Run `walter new project --help` for details.
  project --interactive        AI-powered interview (LLM required). Generates AGENTS.md
                               + spec charter + Plane epic command.
                               Add --write to persist generated files to disk.
NEW_USAGE
        ;;
      *)        log_err "walter new: unknown subcommand '$sub' (try: project)"; exit 2 ;;
    esac
    ;;

  ask)        exec bash "$WALTER_LIB/subcommands/ask.sh" "$@" ;;
  explain)    exec bash "$WALTER_LIB/subcommands/explain.sh" "$@" ;;
  pivot)      exec bash "$WALTER_LIB/subcommands/pivot.sh" "$@" ;;

  ai)         exec bash "$WALTER_LIB/subcommands/ai.sh" "$@" ;;
  providers) exec bash "$WALTER_LIB/subcommands/providers.sh" "$@" ;;
  overlay)   exec bash "$WALTER_LIB/subcommands/overlay.sh" "$@" ;;

  status)     exec bash "$WALTER_LIB/subcommands/status.sh" "$@" ;;
  deploy)     exec bash "$WALTER_LIB/subcommands/deploy.sh" "$@" ;;
  logs)       exec bash "$WALTER_LIB/subcommands/logs.sh" "$@" ;;
  alert)      exec bash "$WALTER_LIB/subcommands/alert.sh" "$@" ;;
  doctor)     exec bash "$WALTER_LIB/subcommands/doctor.sh" "$@" ;;
  audit)      exec "$WALTER_OS_HOME/bin/walter-os" audit "$@" ;;
  secrets)    exec bash "$WALTER_LIB/subcommands/secrets.sh" "$@" ;;
  vm)         exec bash "$WALTER_LIB/subcommands/vm.sh" "$@" ;;

  *)
    log_err "Unknown command: $cmd"
    usage
    exit 2
    ;;
esac
