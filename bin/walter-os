# ---------- profile (MCP load profile switcher) ----------

cmd_profile() {
  local target="${1:-}"
  local claude_dir="${HOME}/.claude"
  local active="${claude_dir}/settings.json"
  local default="${claude_dir}/settings.default.json"
  local high_risk="${claude_dir}/settings.high-risk.json"

  if [[ -z "$target" ]]; then
    # Report current profile.
    if [[ -f "$default" && ! -f "$high_risk" ]]; then
      echo "default (high-risk profile not staged)"
    elif [[ -f "$high_risk" && ! -f "$default" ]]; then
      echo "high-risk (default profile saved as backup)"
    elif [[ -f "$default" && -f "$high_risk" ]]; then
      echo "indeterminate — both backups present, manual cleanup needed"
      echo "  ${default}"
      echo "  ${high_risk}"
      return 2
    else
      echo "unknown — no backups present, can't tell which profile is loaded"
      return 0
    fi
    return 0
  fi

  local generator="${WALTER_OS_HOME}/scripts/generate-mcp-configs.sh"
  if [[ ! -x "$generator" ]]; then
    echo "walter-os: missing $generator. Run install.sh." >&2
    exit 3
  fi

  case "$target" in
    default)
      if [[ -f "$high_risk" && ! -f "$default" ]]; then
        echo "walter-os: already on high-risk profile? Looks like a stale state."
        echo "  Restoring default would clobber high-risk backup. Aborting."
        return 2
      fi
      # Regenerate from servers.json (default profile only)
      require_jq
      local generated; generated="$("$generator" claude all default 2>/dev/null || echo '{}')"
      [[ -z "$generated" || "$generated" == "{}" ]] && {
        echo "walter-os: generator emitted empty config, refusing to clobber settings.json" >&2
        exit 3
      }
      cp "$active" "${active}.bak.$(date +%s)"
      jq --argjson new "$generated" '.mcpServers = $new' "$active" > "${active}.tmp"
      mv "${active}.tmp" "$active"
      rm -f "$high_risk" "$default"
      echo "✓ profile: default (mcpServers replaced from servers.json)"
      ;;
    high-risk)
      if [[ -f "$high_risk" ]]; then
        echo "walter-os: high-risk profile is already active."
        return 0
      fi
      require_jq
      local default_json; default_json="$("$generator" claude all default 2>/dev/null || echo '{}')"
      local manual_json; manual_json="$("$generator" claude all manual 2>/dev/null || echo '{}')"
      local merged; merged="$(jq -n --argjson d "$default_json" --argjson m "$manual_json" '$d + $m')"
      cp "$active" "$default"  # save default as backup
      jq --argjson new "$merged" '.mcpServers = $new' "$active" > "${active}.tmp"
      mv "${active}.tmp" "$active"
      touch "$high_risk"  # marker; content is the live settings.json
      echo "✓ profile: high-risk (default + manual MCPs loaded)"
      echo "  Switch back: walter-os profile default"
      ;;
    *)
      echo "walter-os: unknown profile '$target'. Use: default | high-risk" >&2
      exit 2
      ;;
  esac
}

# ---------- secrets-pull (Vaultwarden → ~/.config/walter-os/secrets.env) ----------

cmd_secrets_pull() {
  local action="${1:-pull}"
  local secrets="${WALTER_CONFIG}/secrets.env"

  if ! command -v bw >/dev/null 2>&1; then
    echo "walter-os: Bitwarden CLI 'bw' not found. Install: brew install bitwarden-cli" >&2
    echo "  Then: bw login && bw unlock" >&2
    exit 3
  fi

  # bw status returns "unlocked" / "locked" / "unauthenticated"
  local status; status="$(bw status 2>/dev/null | jq -r '.status' 2>/dev/null || echo unauthenticated)"
  if [[ "$status" != "unlocked" ]]; then
    echo "walter-os: Bitwarden vault is $status. Unlock first:" >&2
    echo "  export BW_SESSION=\$(bw unlock --raw)" >&2
    exit 3
  fi

  if [[ "$action" == "--list" || "$action" == "list" ]]; then
    echo "Items tagged 'walter-os':"
    bw list items --search walter-os 2>/dev/null \
      | jq -r '.[] | "  \(.name)"' \
      | sort -u
    return 0
  fi

  # Look for an item literally named "walter-os/secrets" — JSON envelope with
  # all secrets. If found, decrypt + write atomically. If not, instruct the
  # operator to create it.
  local item_id; item_id="$(bw list items --search 'walter-os/secrets' 2>/dev/null \
    | jq -r '.[] | select(.name == "walter-os/secrets") | .id' \
    | head -1)"

  if [[ -z "$item_id" ]]; then
    cat >&2 <<EOF
walter-os: no Bitwarden item named 'walter-os/secrets' found.

Create one with the secret notes contents in dotenv format:
  bw create item ...    (or via the web/desktop UI)

Item shape:
  name: walter-os/secrets
  type: 2 (secure note)
  notes: |
    export ANTHROPIC_API_KEY="..."
    export OPENAI_API_KEY="..."
    ...

Then re-run: walter-os secrets-pull
EOF
    exit 4
  fi

  local notes; notes="$(bw get notes "$item_id" 2>/dev/null)"
  if [[ -z "$notes" ]]; then
    echo "walter-os: item 'walter-os/secrets' has empty notes. Aborting." >&2
    exit 4
  fi

  # Atomic write — preserves mode 600.
  local tmp; tmp="$(mktemp "${secrets}.XXXXXX")"
  printf '%s\n' "$notes" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$secrets"
  echo "✓ wrote $(wc -l < "$secrets" | tr -d ' ') lines to $secrets"
  echo "  Source it: source $secrets"
}

