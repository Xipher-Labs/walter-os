# ---------- new (project induction) ----------

cmd_new() {
  local subcmd="${1:-}"
  shift || true

  if [[ "$subcmd" != "project" ]]; then
    if [[ "$subcmd" =~ ^(-h|--help|help)$ ]]; then
      cat <<NEW_USAGE
Usage: walter-os new <subcommand> [options]

Subcommands:
  project <type> <name> [opts]    Start project induction interview
                                  Types: webapp | service | solana | hackathon | personal

Project options:
  --output-dir <path>             Write charter + AGENTS.md here (default: docs/specs/)
  --skip-plane                    Skip Plane epic creation
  --non-interactive               Non-interactive mode; requires --answers-file
  --answers-file <path>           YAML with pre-filled answers (for scripted use)

Examples:
  walter-os new project webapp my-app
  walter-os new project solana anchor-staking --output-dir /tmp/test

Spec: docs/specs/walter-council-v2.md — Improvement 6 (T-24)
NEW_USAGE
      exit 0
    fi
    echo "Usage: walter-os new project <type> <name> [options]" >&2
    echo "  Types: webapp | service | solana | hackathon | personal" >&2
    [[ -z "$subcmd" ]] || echo "  Unknown subcommand: $subcmd" >&2
    exit 2
  fi

  # `new project <type> <name> [opts...]`
  local project_type="${1:-}"
  local project_name="${2:-}"

  # Handle --help before validation
  if [[ "$project_type" =~ ^(-h|--help|help)$ ]]; then
    cmd_new --help
    exit 0
  fi

  if [[ -z "$project_type" || -z "$project_name" ]]; then
    echo "Usage: walter-os new project <type> <name> [options]" >&2
    echo "  Types: webapp | service | solana | hackathon | personal" >&2
    exit 2
  fi

  # Validate type (same list as induction.sh)
  local valid_types=("webapp" "service" "solana" "hackathon" "personal")
  local type_ok=0
  for t in "${valid_types[@]}"; do
    [[ "$project_type" == "$t" ]] && type_ok=1 && break
  done
  if [[ "$type_ok" -eq 0 ]]; then
    echo "walter-os new project: invalid type '$project_type'." >&2
    echo "  Valid types: ${valid_types[*]}" >&2
    exit 2
  fi

  # Validate name: alphanumeric+hyphens, 1-50 chars
  if ! echo "$project_name" | grep -qE '^[a-zA-Z0-9][a-zA-Z0-9-]{0,49}$'; then
    echo "walter-os new project: invalid name '$project_name'." >&2
    echo "  Name must be alphanumeric+hyphens, ≤ 50 chars." >&2
    exit 2
  fi

  shift 2 || true  # remove type and name; pass remaining opts to induction.sh

  local induction="${WALTER_OS_HOME}/skills/project-induction/scripts/induction.sh"
  if [[ ! -x "$induction" ]]; then
    echo "walter-os new project: induction.sh not found at $induction" >&2
    echo "  Run install.sh to ensure skills are installed." >&2
    exit 3
  fi

  exec "$induction" \
    --project-type "$project_type" \
    --project-name "$project_name" \
    "$@"
}

# ---------- content analytics (Phase V — devrel-analyst) ----------

cmd_content() {
  local sub="${1:-stats}"
  shift || true
  case "$sub" in
    stats)
      # walter-os content stats [--since 30d] [--dry-run]
      # Delegates to devrel-analyst skill query.py
      local query_py="${WALTER_OS_HOME}/skills/devrel-analyst/scripts/query.py"
      if [[ ! -f "$query_py" ]]; then
        echo "walter-os content: devrel-analyst skill not found at $query_py" >&2
        exit 3
      fi
      python3 "$query_py" top_threads "$@"
      ;;
    analyst)
      # walter-os content analyst <query> [args]
      # Direct passthrough to devrel-analyst query.py
      local query_py="${WALTER_OS_HOME}/skills/devrel-analyst/scripts/query.py"
      if [[ ! -f "$query_py" ]]; then
        echo "walter-os content: devrel-analyst skill not found at $query_py" >&2
        exit 3
      fi
      python3 "$query_py" "$@"
      ;;
    prereqs)
      # walter-os content prereqs — check Singer + API prereqs
      local check="${WALTER_OS_HOME}/setup/walter-host/singer/check-prereqs.sh"
      if [[ ! -x "$check" ]]; then
        echo "walter-os content: check-prereqs.sh not found" >&2
        exit 3
      fi
      bash "$check" "$@"
      ;;
    -h|--help|help)
      echo "Usage: walter-os content <subcommand>"
      echo "  stats [--since 30d] [--dry-run]    Top threads by engagement"
      echo "  analyst <query> [args]              Run any devrel-analyst query"
      echo "    Queries: top_threads, optimal_hours, pattern_match,"
      echo "             roi_per_content_piece, weekly_digest"
      echo "  prereqs                             Check Singer tap + API prereqs"
      echo ""
      echo "Examples:"
      echo "  walter-os content stats --since 7d --limit 10"
      echo "  walter-os content analyst pattern_match --topic solana-rpc"
      echo "  walter-os content analyst weekly_digest --dry-run"
      ;;
    *)
      echo "walter-os content: unknown subcommand '$sub'" >&2
      echo "  Run: walter-os content help" >&2
      exit 2
      ;;
  esac
}

# ---------- version ----------

cmd_version() {
  # Source _version_is_newer from the shared lib on first use (lazy).
  # Keeps the blast radius small: only 'version' fails if the lib is absent.
  # shellcheck source=/dev/null
  source "${WALTER_OS_HOME}/scripts/walter/lib/version-compare.sh" 2>/dev/null \
    || { echo "walter-os: missing scripts/walter/lib/version-compare.sh" >&2; exit 1; }

  local version_file="${WALTER_OS_HOME}/VERSION"
  if [[ ! -f "$version_file" ]]; then
    echo "walter-os: VERSION file not found at $version_file" >&2
    exit 3
  fi
  local current
  current="$(cat "$version_file")"
  current="${current//[$'\r\n\t ']/}"  # strip any whitespace

  echo "Walter-OS v${current}"

  # Update check: skip if WALTER_OS_SKIP_UPDATE_CHECK is set (e.g., tests),
  # or if curl is unavailable.
  if [[ "${WALTER_OS_SKIP_UPDATE_CHECK:-}" == "1" ]]; then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  # Resolve the GitHub repo to query for releases. Precedence:
  #   1. WALTER_OS_UPDATE_REPO env var if set (operator-explicit choice)
  #   2. Derive from `git remote get-url origin` inside the walter-os
  #      checkout — that's the actual upstream the operator forked from
  #      or tracks today.
  #   3. Empty → skip the update check with a friendly WARN. We
  #      intentionally do NOT carry a hardcoded fallback to any
  #      specific GitHub org (see PR #73 / W-5 depersonalization
  #      audit) so the binary doesn't ship operator-org references.
  local update_repo="${WALTER_OS_UPDATE_REPO:-}"
  if [[ -z "$update_repo" && -d "${WALTER_OS_HOME}/.git" ]]; then
    local origin_url
    origin_url="$(git -C "$WALTER_OS_HOME" remote get-url origin 2>/dev/null || true)"
    # Match both git@github.com:owner/repo(.git) and https://github.com/owner/repo(.git)
    if [[ "$origin_url" =~ github\.com[:/]([^/]+)/([^/.]+)(\.git)?$ ]]; then
      update_repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    fi
  fi
  if [[ -z "$update_repo" ]]; then
    echo "INFO: walter-os version: cannot determine upstream repo (set WALTER_OS_UPDATE_REPO or run from a clone with an 'origin' remote on github.com). Update check skipped." >&2
    return 0
  fi
  if [[ ! "$update_repo" =~ ^[^/]+/[^/]+$ ]]; then
    echo "WARN: WALTER_OS_UPDATE_REPO must be 'owner/repo' format, got: ${update_repo}. Update check skipped." >&2
    return 0
  fi
  local owner="${update_repo%/*}"
  local repo="${update_repo#*/}"
  local api_url="https://api.github.com/repos/${owner}/${repo}/releases/latest"
  local auth_header=""
  [[ -n "${GITHUB_TOKEN:-}" ]] && auth_header="Authorization: Bearer ${GITHUB_TOKEN}"

  local latest_tag
  if [[ -n "$auth_header" ]]; then
    latest_tag="$(curl -fsSL --max-time 5 --connect-timeout 3 -H "$auth_header" "$api_url" 2>/dev/null \
      | grep '"tag_name"' | head -1 | sed 's/.*"tag_name": *"\(.*\)".*/\1/')"
  else
    latest_tag="$(curl -fsSL --max-time 5 --connect-timeout 3 "$api_url" 2>/dev/null \
      | grep '"tag_name"' | head -1 | sed 's/.*"tag_name": *"\(.*\)".*/\1/')"
  fi

  if [[ -z "$latest_tag" ]]; then
    return 0  # network unavailable or API rate-limited — silent
  fi

  local latest_version="${latest_tag#v}"  # strip leading 'v' if present

  if _version_is_newer "$latest_version" "$current"; then
    echo "(update available: v${latest_version} — https://github.com/${owner}/${repo}/releases/tag/${latest_tag})"
  else
    echo "(up to date)"
  fi
}

# ---------- doctor ----------

# _doctor_cursor_probe: reports the state of the project-local Cursor
# MDC adapter at <cwd>/.cursor/rules/walter-os.mdc.
#
# Three possible outputs (all exit 0 — informational, not gating):
#   PASS         — file exists and recorded SHA matches current AGENTS.md
#   STALE        — file exists but the hash is outdated
#   NOT_GENERATED — file absent. Either:
#                   - operator didn't opt in via install.sh --cursor-rules
#                   - Cursor reads AGENTS.md natively (recent versions) so
#                     no adapter is required.
#
# Spec: docs/specs/cursor-adapter-completion.md
_doctor_cursor_probe() {
  local cwd
  cwd="$(pwd)"
  local mdc="$cwd/.cursor/rules/walter-os.mdc"
  local agents="$cwd/AGENTS.md"

  echo "Walter-OS doctor — Cursor adapter probe"
  echo

  # Cursor presence (informational; not gating).
  if command -v cursor >/dev/null 2>&1; then
    printf "  ℹ Cursor CLI detected: %s\n" "$(command -v cursor)"
  else
    printf "  ℹ Cursor CLI not detected. Recent Cursor versions read\n"
    printf "    AGENTS.md natively. The MDC adapter is opt-in convenience.\n"
  fi

  if [[ ! -f "$mdc" ]]; then
    echo
    printf "  STATUS: NOT_GENERATED\n"
    printf "  Adapter file absent: %s\n" "$mdc"
    printf "  Either Cursor reads AGENTS.md natively (no action needed),\n"
    printf "  or run: ./install.sh --cursor-rules\n"
    return 0
  fi

  if [[ ! -f "$agents" ]]; then
    echo
    printf "  STATUS: WARN — adapter exists but no AGENTS.md to compare against.\n"
    printf "  Adapter: %s\n" "$mdc"
    printf "  AGENTS.md path checked: %s (missing)\n" "$agents"
    return 0
  fi

  # Extract recorded hash from the trailing comment in the adapter.
  # Use the portable sha256 helper (sha256sum on Debian/Ubuntu/Alpine;
  # shasum on macOS). Matches the pattern at lines 311-314.
  local recorded current
  recorded="$(grep -oE 'agents-md-sha256: [0-9a-f]{64}' "$mdc" | awk '{print $2}' | head -1)"
  if command -v sha256sum >/dev/null 2>&1; then
    current="$(sha256sum "$agents" | awk '{print $1}')"
  elif command -v shasum >/dev/null 2>&1; then
    current="$(shasum -a 256 "$agents" | awk '{print $1}')"
  else
    echo
    printf "  STATUS: ERROR — no sha256 tool available (need sha256sum or shasum).\n"
    return 1
  fi

  if [[ -z "$recorded" ]]; then
    echo
    printf "  STATUS: STALE\n"
    printf "  Adapter has no recorded hash — predates the staleness mechanism.\n"
    printf "  Run: ./install.sh --cursor-rules\n"
    return 0
  fi

  if [[ "$recorded" == "$current" ]]; then
    echo
    printf "  STATUS: PASS\n"
    printf "  Adapter is current.\n"
    printf "    file: %s\n" "$mdc"
    printf "    sha:  %s\n" "$current"
    return 0
  fi

  echo
  printf "  STATUS: STALE\n"
  printf "  Adapter hash does not match the current AGENTS.md.\n"
  printf "    recorded: %s\n" "$recorded"
  printf "    current:  %s\n" "$current"
  printf "  Run: ./install.sh --cursor-rules\n"
  return 0
}

# _doctor_antigravity_probe: reports the state of the project-local
# Antigravity adapter at <cwd>/.agent/rules/walter-os.md, AND surfaces a
# GEMINI.md collision that would silently shadow AGENTS.md.
#
# Outputs (all exit 0 — informational, not gating):
#   PASS         — adapter present and SHA matches AGENTS.md
#   STALE        — adapter present but hash is outdated
#   NOT_GENERATED — adapter absent. Either:
#                   - operator didn't opt in via install.sh --antigravity-rules
#                   - Antigravity v1.20.3+ reads AGENTS.md natively so no
#                     adapter is required.
#   WARN — adapter exists but no AGENTS.md to compare against, OR a stray
#          GEMINI.md takes precedence over AGENTS.md.
#
# Spec: docs/specs/antigravity-adapter.md
_doctor_antigravity_probe() {
  local cwd
  cwd="$(pwd)"
  local md="$cwd/.agent/rules/walter-os.md"
  local agents="$cwd/AGENTS.md"
  local gemini="$cwd/GEMINI.md"

  echo "Walter-OS doctor — Antigravity adapter probe"
  echo

  # GEMINI.md takes precedence over AGENTS.md in Antigravity — it
  # silently shadows the cascade. Warn (independent of adapter state).
  if [[ -f "$gemini" ]]; then
    printf "  ⚠ GEMINI.md present at %s — Antigravity gives it precedence\n" "$gemini"
    printf "    over AGENTS.md, silently shadowing the Walter-OS cascade.\n"
    printf "    Either remove GEMINI.md or merge its rules into AGENTS.md.\n"
    echo
  fi

  if [[ ! -f "$md" ]]; then
    printf "  STATUS: NOT_GENERATED\n"
    printf "  Adapter file absent: %s\n" "$md"
    printf "  Either Antigravity reads AGENTS.md natively (v1.20.3+ — no action),\n"
    printf "  or run: ./install.sh --antigravity-rules\n"
    return 0
  fi

  if [[ ! -f "$agents" ]]; then
    printf "  STATUS: WARN — adapter exists but no AGENTS.md to compare against.\n"
    printf "  Adapter: %s\n" "$md"
    printf "  AGENTS.md path checked: %s (missing)\n" "$agents"
    return 0
  fi

  local recorded current
  recorded="$(grep -oE 'agents-md-sha256: [0-9a-f]{64}' "$md" | awk '{print $2}' | head -1)"
  if command -v sha256sum >/dev/null 2>&1; then
    current="$(sha256sum "$agents" | awk '{print $1}')"
  elif command -v shasum >/dev/null 2>&1; then
    current="$(shasum -a 256 "$agents" | awk '{print $1}')"
  else
    printf "  STATUS: ERROR — no sha256 tool available (need sha256sum or shasum).\n"
    return 1
  fi

  if [[ -z "$recorded" ]]; then
    printf "  STATUS: STALE\n"
    printf "  Adapter has no recorded hash — predates the staleness mechanism.\n"
    printf "  Run: ./install.sh --antigravity-rules\n"
    return 0
  fi

  if [[ "$recorded" == "$current" ]]; then
    printf "  STATUS: PASS\n"
    printf "  Adapter is current.\n"
    printf "    file: %s\n" "$md"
    printf "    sha:  %s\n" "$current"
    return 0
  fi

  printf "  STATUS: STALE\n"
  printf "  Adapter hash does not match the current AGENTS.md.\n"
  printf "    recorded: %s\n" "$recorded"
  printf "    current:  %s\n" "$current"
  printf "  Run: ./install.sh --antigravity-rules\n"
  return 0
}

# _doctor_lite_probe: reports the state of the Lite-persist contract at
# <cwd>/.walter-os-lite/AGENTS.md. See docs/specs/walter-os-lite-entry-tier.md.
#
# Outputs (informational, exit 0/1 follows the spec AC-6):
#   PASS — .walter-os-lite/AGENTS.md present; print the discipline headings.
#   NONE — file absent; print the install callout.
_doctor_lite_probe() {
  local cwd
  cwd="$(pwd)"
  local lite_md="$cwd/.walter-os-lite/AGENTS.md"

  echo "Walter-OS doctor — Lite contract probe"
  echo

  if [[ ! -f "$lite_md" ]]; then
    printf "  STATUS: NONE\n"
    printf "  No Lite contract installed in this repo (file absent: %s).\n" "$lite_md"
    printf "  Install:\n"
    printf "    1. Paste setup/agent-install/lite.md into your agent (in-session only).\n"
    printf "    2. OR paste setup/agent-install/lite-persist.md to persist to %s\n" "$lite_md"
    printf "       across all future sessions in this repo.\n"
    return 1
  fi

  printf "  STATUS: PASS\n"
  printf "  Lite contract installed: %s\n" "$lite_md"
  printf "  Disciplines:\n"
  # Extract the ## headings from the Lite-persist AGENTS.md.
  grep -E '^## [0-9]+\.' "$lite_md" | sed 's/^/    /'
  return 0
}

_doctor_codex_startup_probe() {
  local issues=0
  local warns=0

  echo "Walter-OS doctor — Codex startup probe"
  echo

  local lint="${WALTER_SKILL_FRONTMATTER_LINT:-${WALTER_OS_HOME}/tests/lint-frontmatter.sh}"
  if [[ -x "$lint" || -f "$lint" ]]; then
    local lint_output
    lint_output="$(mktemp)"
    if bash "$lint" >"$lint_output" 2>&1; then
      printf "  PASS repo skills frontmatter: valid YAML and Codex metadata limits\n"
    else
      printf "  FAIL repo skills frontmatter: loader-visible repo skills are invalid\n"
      grep -E '✗|invalid|exceeds|missing' "$lint_output" | sed 's/^/    /' || true
      issues=$((issues + 1))
    fi
    rm -f "$lint_output"
  else
    printf "  WARN repo skills frontmatter: lint command not found at %s\n" "$lint"
    warns=$((warns + 1))
  fi

  echo
  _doctor_codex_plugin_cache_probe && true
  warns=$((warns + WALTER_DOCTOR_PLUGIN_WARNINGS))

  echo
  _doctor_codex_mcp_probe && true
  warns=$((warns + WALTER_DOCTOR_MCP_WARNINGS))

  echo
  printf "Codex startup summary: %d issue(s), %d warning(s)\n" "$issues" "$warns"
  [[ "$issues" -eq 0 ]]
}

_doctor_codex_plugin_cache_probe() {
  WALTER_DOCTOR_PLUGIN_WARNINGS=0
  local cache="${WALTER_CODEX_PLUGIN_CACHE:-${HOME}/.codex/plugins/cache}"

  echo "Plugin-cache skills:"
  if [[ ! -d "$cache" ]]; then
    printf "  PASS plugin cache: not present at %s\n" "$cache"
    return 0
  fi

  if ! command -v ruby >/dev/null 2>&1; then
    printf "  WARN plugin cache: ruby unavailable, cannot parse managed skill metadata\n"
    WALTER_DOCTOR_PLUGIN_WARNINGS=1
    return 0
  fi

  local result
  result="$(ruby - "$cache" <<'RUBY'
require "yaml"

root = ARGV.fetch(0)
warnings = []

Dir.glob(File.join(root, "**", "SKILL.md")).sort.each do |path|
  text = File.read(path)
  frontmatter = text.split(/^---\s*$/m, 3)[1]
  next unless frontmatter

  begin
    data = YAML.safe_load(frontmatter, permitted_classes: [], permitted_symbols: [], aliases: false)
  rescue Psych::Exception => e
    warnings << "#{path}: invalid YAML frontmatter (#{e.class})"
    next
  end

  next unless data.is_a?(Hash)

  name = data["name"]
  description = data["description"]
  warnings << "#{path}: name exceeds 64 chars (#{name.length})" if name.is_a?(String) && name.length > 64
  if description.is_a?(String) && description.length > 1024
    warnings << "#{path}: description exceeds 1024 chars (#{description.length})"
  end
end

if warnings.empty?
  puts "PASS plugin cache metadata: no Codex loader limit warnings found"
else
  puts "WARN plugin cache metadata: #{warnings.length} managed issue(s)"
  warnings.first(8).each { |warning| puts "  #{warning}" }
  puts "  Action: update/reinstall the plugin or report upstream; do not hand-edit plugin cache files."
end
RUBY
)"

  printf '%s\n' "$result" | sed 's/^/  /'
  if [[ "$result" == WARN* ]]; then
    WALTER_DOCTOR_PLUGIN_WARNINGS=1
  fi
  return 0
}

_doctor_codex_mcp_probe() {
  WALTER_DOCTOR_MCP_WARNINGS=0
  local registry="${WALTER_MCP_REGISTRY:-${WALTER_OS_HOME}/mcp/servers.json}"

  echo "MCP registry readiness:"
  if [[ ! -f "$registry" ]]; then
    printf "  WARN MCP registry: not found at %s\n" "$registry"
    WALTER_DOCTOR_MCP_WARNINGS=1
    return 0
  fi

  if ! command -v jq >/dev/null 2>&1; then
    printf "  WARN MCP registry: jq unavailable, cannot classify server startup risks\n"
    WALTER_DOCTOR_MCP_WARNINGS=1
    return 0
  fi

  local total=0
  local rows
  if ! rows="$(jq -c '
    .servers
    | to_entries[]
    | select((.value.disabled // false) | not)
    | select((.value.load // "default") == "default")
    | {
        name: .key,
        type: (.value.type // "stdio"),
        command: (.value.command // ""),
        refs: ([((.value.env // {})[]?), ((.value.headers // {})[]?), ((.value.args // [])[]?)]
          | map(tostring)
          | join(" "))
      }
  ' "$registry" 2>/dev/null)"; then
    printf "  FAIL MCP registry: invalid JSON or unexpected schema at %s\n" "$registry"
    WALTER_DOCTOR_MCP_WARNINGS=1
    return 0
  fi

  local row name type command refs
  while IFS= read -r row; do
    name="$(jq -r '.name' <<<"$row")"
    type="$(jq -r '.type' <<<"$row")"
    command="$(jq -r '.command' <<<"$row")"
    refs="$(jq -r '.refs' <<<"$row")"
    [[ -n "$name" ]] || continue
    total=$((total + 1))

    if [[ -n "$command" ]] && ! command -v "$command" >/dev/null 2>&1; then
      printf "  WARN mcp/%s: missing command '%s'\n" "$name" "$command"
      WALTER_DOCTOR_MCP_WARNINGS=$((WALTER_DOCTOR_MCP_WARNINGS + 1))
    fi

    local mcp_missing_vars=()
    local var
    while IFS= read -r var; do
      [[ -n "$var" ]] || continue
      var="${var#\$\{}"
      var="${var%\}}"
      if [[ -z "${!var:-}" ]]; then
        mcp_missing_vars+=("$var")
      fi
    done < <(printf '%s\n' "${refs:-}" | grep -oE '\$\{[A-Za-z_][A-Za-z0-9_]*\}' | sort -u || true)

    if [[ "${#mcp_missing_vars[@]}" -gt 0 ]]; then
      printf "  WARN mcp/%s: missing env %s\n" "$name" "${mcp_missing_vars[*]}"
      WALTER_DOCTOR_MCP_WARNINGS=$((WALTER_DOCTOR_MCP_WARNINGS + 1))
    elif [[ -z "$command" && "$type" != "stdio" ]]; then
      printf "  PASS mcp/%s: remote/%s config present\n" "$name" "$type"
    fi
  done <<<"$rows"

  if [[ "$total" -eq 0 ]]; then
    printf "  WARN MCP registry: no enabled default-profile servers found\n"
    WALTER_DOCTOR_MCP_WARNINGS=$((WALTER_DOCTOR_MCP_WARNINGS + 1))
  else
    printf "  PASS MCP registry parsed: %d enabled default-profile server(s)\n" "$total"
  fi

  if [[ "$WALTER_DOCTOR_MCP_WARNINGS" -gt 0 ]]; then
    printf "  Action: install missing commands, populate env/tokens, or treat the MCP as optional/local-service dependent.\n"
  fi
  return 0
}

_doctor_repo_config_probe() {
  echo "Walter-OS doctor — repo config"
  echo

  # shellcheck source=/dev/null
  source "${WALTER_OS_HOME}/scripts/walter/lib/repo-config.sh"
  walter_repo_config_validate "$(pwd)"
}

# cmd_uninstall: front for `install.sh --uninstall`.
#
# Walter-OS Gap 4 from #191: operators who lose the repo clone need a
# way to uninstall via the CLI. This dispatches to the install.sh in
# WALTER_OS_HOME so logic stays single-sourced.
#
# Flags are forwarded as-is, so `walter-os uninstall --restore-backups`
# and `walter-os uninstall --no-restore-backups` work transparently.
cmd_uninstall() {
  local install_sh="${WALTER_OS_HOME}/install.sh"
  if [[ ! -x "$install_sh" ]] && [[ ! -f "$install_sh" ]]; then
    echo "walter-os uninstall: install.sh not found at $install_sh" >&2
    echo "  Set WALTER_OS_HOME to the repo root and retry, or run" >&2
    echo "  install.sh --uninstall directly from the clone." >&2
    return 2
  fi
  exec bash "$install_sh" --uninstall "$@"
}

# ---------- egress (#122 A-2: network egress allowlist) ----------
#
# Manages the operator's egress allowlist file consumed by the
# `hooks/network-gate.sh` PreToolUse hook + the egress-loader lib.
# Spec: docs/specs/network-egress-allowlist.md
#
# Subcommands:
#   egress add <host>      idempotent append to allowlist
#   egress remove <host>   idempotent remove (missing entry is no-op)
#   egress list            cat the allowlist (with hint if empty/missing)
#   egress test <host>     query loader; exit 0 on allow / 1 on deny
#   egress import <path>   overwrite allowlist with envsubst of <path>
#                          (lines referencing unset ${VAR} are skipped
#                           with WARN on stderr).

_egress_allowlist_path() {
  # Delegate to the loader's resolver when sourceable so both halves
  # (`add`/`remove`/`list`/`import` here + `test` via sourced loader)
  # see the same on-disk file. Falls back to the same default literal
  # if the loader isn't reachable (e.g. walter-os symlinked outside
  # its repo). Copilot R2 NIT.
  local loader="${WALTER_OS_HOME}/scripts/walter/lib/egress-loader.sh"
  if [[ -f "$loader" ]]; then
    # shellcheck disable=SC1090
    ( source "$loader" && walter_egress_allowlist_path )
    return
  fi
  echo "${WALTER_CONFIG:-${HOME}/.config/walter-os}/egress-allowlist.txt"
}

_egress_print_usage() {
  cat >&2 <<'USAGE'
Usage: walter-os egress <subcommand> [args]

  add <host>      Append host to the allowlist (idempotent)
  remove <host>   Remove host from the allowlist (idempotent)
  list            Print the current allowlist
  test <host>     Probe the loader; exit 0 if allowed, 1 if denied
  import <path>   Overwrite the allowlist from <path> (with envsubst)

  Spec: docs/specs/network-egress-allowlist.md
USAGE
}

# Validate a host argument. Accepts apex domains (`foo.com`),
# subdomains, per-spec wildcards (`*.foo.com`, `*.*.foo.com`), and IPv6
# bracketed literals (`[::1]`, `[fd00::1]`).
# Rejects empty strings + anything with whitespace or shell metachars.
_egress_validate_host() {
  local host="$1"
  if [[ -z "$host" ]]; then
    echo "walter-os egress: host argument is required" >&2
    return 2
  fi
  # Two valid shapes (covering DNS hostnames, wildcards, and IPv6
  # bracketed literals). Split the check to dodge POSIX character-class
  # escaping for `[` and `]`, which differs subtly across regex engines.
  #   1. DNS hostname or wildcard: `[A-Za-z0-9._*-]+`
  #   2. IPv6 bracketed literal:   `\[[0-9a-fA-F:]+\]`  (R2 W1)
  if [[ "$host" =~ ^[A-Za-z0-9._*-]+$ ]]; then
    return 0
  fi
  if [[ "$host" =~ ^\[[0-9a-fA-F:]+\]$ ]]; then
    return 0
  fi
  echo "walter-os egress: invalid host '$host' — must be a DNS hostname (with optional '*' label) or an IPv6 bracketed literal like '[::1]'" >&2
  return 2
}

cmd_egress() {
  if [[ $# -lt 1 ]]; then
    _egress_print_usage
    return 2
  fi
  local sub="$1"; shift
  local file
  file="$(_egress_allowlist_path)"

  case "$sub" in
    add)
      local host="${1:-}"
      _egress_validate_host "$host" || return $?
      mkdir -p "$(dirname "$file")"
      [[ -f "$file" ]] || : > "$file"
      if grep -qxF -- "$host" "$file"; then
        echo "walter-os egress: '$host' already in allowlist (idempotent)" >&2
      else
        printf '%s\n' "$host" >> "$file"
        echo "walter-os egress: added '$host'" >&2
      fi
      ;;
    remove|rm)
      local host="${1:-}"
      _egress_validate_host "$host" || return $?
      if [[ ! -f "$file" ]]; then
        echo "walter-os egress: no allowlist at $file (nothing to remove)" >&2
        return 0
      fi
      if grep -qxF -- "$host" "$file"; then
        local tmp; tmp="$(mktemp)"
        grep -vxF -- "$host" "$file" > "$tmp" || true
        mv "$tmp" "$file"
        echo "walter-os egress: removed '$host'" >&2
      else
        echo "walter-os egress: '$host' not in allowlist (idempotent)" >&2
      fi
      ;;
    list|ls)
      if [[ ! -s "$file" ]]; then
        echo "# walter-os egress: allowlist at $file is empty or missing." >&2
        echo "# Hint: walter-os egress import \"\${WALTER_OS_HOME}/contexts/_examples/egress-allowlist.example.txt\"" >&2
        echo "#  or:  walter-os egress add <host>" >&2
        return 0
      fi
      cat "$file"
      ;;
    test)
      local host="${1:-}"
      _egress_validate_host "$host" || return $?
      # Source loader fresh per invocation so each test sees the current
      # on-disk allowlist (no caching).
      # shellcheck source=/dev/null
      # shellcheck disable=SC1090
      source "${WALTER_OS_HOME}/scripts/walter/lib/egress-loader.sh"
      if walter_egress_host_allowed "$host"; then
        echo "allowed: $host"
        return 0
      else
        echo "denied: $host"
        return 1
      fi
      ;;
    import)
      local src="${1:-}"
      if [[ -z "$src" ]]; then
        echo "walter-os egress import: source path required" >&2
        return 2
      fi
      if [[ ! -f "$src" ]]; then
        echo "walter-os egress import: source not found: $src" >&2
        return 2
      fi
      mkdir -p "$(dirname "$file")"
      local tmp; tmp="$(mktemp)"
      local line line_no=0 skipped_lines="" missing_vars=""
      # Per spec AC-4: lines that reference an unset ${VAR} are SKIPPED
      # with a WARN on stderr (not silently expanded to empty, which
      # would create bogus hosts like `llm.` / `secrets.`).
      while IFS= read -r line || [[ -n "$line" ]]; do
        line_no=$((line_no + 1))
        # Comments + blanks pass through unchanged.
        local stripped="${line#"${line%%[![:space:]]*}"}"
        if [[ -z "$stripped" || "${stripped:0:1}" == "#" ]]; then
          printf '%s\n' "$line" >> "$tmp"
          continue
        fi
        # Find every ${VAR} / $VAR reference in this line. Codex R2 C3
        # finding: the previous implementation depended on `envsubst`
        # (part of gettext) which is NOT installed by default on
        # macOS — so the first-run allowlist import broke on the
        # operator's reference machine. We now collect the references
        # via grep AND do the expansion in pure bash parameter
        # expansion, so no external dependency is needed.
        local var var_unset=0 line_missing=""
        local -a vars_to_expand=()
        while IFS= read -r var; do
          [[ -z "$var" ]] && continue
          # Strip $ + { + } prefix/suffix to get the bare name.
          var="${var#\$}"
          var="${var#\{}"
          var="${var%\}}"
          # Track every unique var name (case-preserving — the same name
          # may appear multiple times in one line).
          local _seen=0 _v
          for _v in "${vars_to_expand[@]}"; do
            [[ "$_v" == "$var" ]] && { _seen=1; break; }
          done
          [[ "$_seen" -eq 0 ]] && vars_to_expand+=("$var")
          # Check if SET + non-empty.
          if [[ -z "${!var:-}" ]]; then
            var_unset=1
            line_missing+=" \$${var}"
          fi
        done < <(printf '%s\n' "$line" | grep -oE '\$\{?[A-Za-z_][A-Za-z0-9_]*\}?' || true)
        if [[ "$var_unset" -eq 1 ]]; then
          echo "walter-os egress import: WARN line $line_no skipped (unset:${line_missing}): $line" >&2
          skipped_lines+="$line"$'\n'
          for v in $line_missing; do
            v="${v#\$}"
            case " $missing_vars " in
              *" $v "*) ;;
              *) missing_vars+="$v " ;;
            esac
          done
          continue
        fi
        # All referenced vars are set → expand the line via pure-bash
        # parameter substitution (no envsubst / gettext dependency).
        # Replace `${VAR}` and `$VAR` forms with the env-resolved value.
        local expanded="$line" vname vval
        for vname in "${vars_to_expand[@]}"; do
          vval="${!vname}"
          # Brace form `${VAR}` first (so we don't half-replace it).
          expanded="${expanded//\$\{$vname\}/$vval}"
          # Bare form `$VAR` second (this matches greedy — could partial-
          # match a longer variable name like `$WALTER_DOMAIN_FOO` if
          # both `WALTER_DOMAIN` and `WALTER_DOMAIN_FOO` were referenced.
          # The grep-derived `vars_to_expand` list is processed in line
          # order, so the longest-prefix-first ordering issue is rare
          # in practice; operators with overlapping names should use
          # the brace form.)
          expanded="${expanded//\$$vname/$vval}"
        done
        printf '%s\n' "$expanded" >> "$tmp"
      done < "$src"
      mv "$tmp" "$file"
      echo "walter-os egress import: wrote $(wc -l < "$file" | tr -d ' ') line(s) to $file" >&2
      if [[ -n "$missing_vars" ]]; then
        echo "walter-os egress import: NOTE — skipped lines referencing unset vars: $missing_vars" >&2
      fi
      ;;
    -h|--help|help)
      _egress_print_usage
      return 0
      ;;
    *)
      echo "walter-os egress: unknown subcommand: $sub" >&2
      _egress_print_usage
      return 2
      ;;
  esac
}

cmd_doctor() {
  # Parse optional --tier N flag. Without it, every check runs (legacy
  # contract preserved). With it, only checks tagged ≤ N run — useful
  # for verifying a tier install (see setup/agent-install/tier-*.md).
  # --cursor: run ONLY the Cursor adapter probe and exit (no other
  # checks). See docs/specs/cursor-adapter-completion.md.
  # --lite: run ONLY the Lite contract probe + exit. See
  # docs/specs/walter-os-lite-entry-tier.md.
  # --codex-startup: run ONLY the Codex startup readiness probe + exit.
  # --repo-config: run ONLY the walter-repo-config.yaml policy probe + exit.
  local tier_filter=""
  local cursor_only=0
  local antigravity_only=0
  local lite_only=0
  local codex_startup_only=0
  local repo_config_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tier)
        tier_filter="${2:-}"
        shift 2 || shift
        ;;
      --tier=*)
        tier_filter="${1#--tier=}"
        shift
        ;;
      --cursor)
        cursor_only=1
        shift
        ;;
      --antigravity)
        antigravity_only=1
        shift
        ;;
      --lite)
        lite_only=1
        shift
        ;;
      --codex-startup)
        codex_startup_only=1
        shift
        ;;
      --repo-config)
        repo_config_only=1
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  if [[ -n "$tier_filter" ]] && ! [[ "$tier_filter" =~ ^[1-4]$ ]]; then
    echo "Error: --tier must be 1, 2, 3, or 4 (got: ${tier_filter})" >&2
    return 1
  fi

  if [[ "$cursor_only" -eq 1 ]]; then
    _doctor_cursor_probe
    return $?
  fi

  if [[ "$antigravity_only" -eq 1 ]]; then
    _doctor_antigravity_probe
    return $?
  fi

  if [[ "$lite_only" -eq 1 ]]; then
    _doctor_lite_probe
    return $?
  fi

  if [[ "$codex_startup_only" -eq 1 ]]; then
    _doctor_codex_startup_probe
    return $?
  fi

  if [[ "$repo_config_only" -eq 1 ]]; then
    _doctor_repo_config_probe
    return $?
  fi

  echo "Walter-OS doctor${tier_filter:+ (tier ${tier_filter})}"
  echo

  local ok=0 issues=0 warns=0

  check() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      printf "  ✓ %s\n" "$label"
      ok=$((ok + 1))
    else
      printf "  ✗ %s\n" "$label"
      issues=$((issues + 1))
    fi
  }

  # check_three_state: an OK/WARN/FAIL probe — distinct from `check` which
  # is binary ✓/✗. The probe is a function that prints `ok` / `warn` /
  # `fail` on stdout. Closes external-review F8 / #123: the secrets.env
  # presence check needs ✓ on a clean Infisical-runtime install (no
  # plaintext file is the GOAL) and only ✗ when both runtime + plaintext
  # paths are unconfigured. Hard-FAIL on legacy plaintext was the
  # historical default and produced false alarms after the Vaultwarden
  # retirement (operator decision 2026-05-05).
  check_three_state() {
    local label="$1" probe="$2" warn_hint="${3:-}"
    local result
    result="$($probe 2>/dev/null)"
    case "$result" in
      ok)
        printf "  ✓ %s\n" "$label"
        ok=$((ok + 1))
        ;;
      warn)
        printf "  ⚠ %s%s\n" "$label" "${warn_hint:+ — ${warn_hint}}"
        warns=$((warns + 1))
        ;;
      *)
        printf "  ✗ %s\n" "$label"
        issues=$((issues + 1))
        ;;
    esac
  }

  # _secrets_runtime_probe: classifies the operator's secrets posture.
  # - ok    = Infisical machine-identity configured (preferred runtime)
  # - warn  = legacy secrets.env exists (still works, but plaintext);
  #          guide operator to migrate to Infisical.
  # - fail  = neither path configured.
  _secrets_runtime_probe() {
    local secrets="${WALTER_CONFIG}/secrets.env"
    local has_infisical_id=0
    # Canonical var: INFISICAL_CLIENT_ID (matches scripts/secrets-bootstrap.sh
    # + scripts/walter/lib/providers/detect.sh + install.sh step 8). The
    # earlier probe used INFISICAL_MACHINE_IDENTITY_CLIENT_ID which doesn't
    # exist anywhere else in the repo — would have left clean Infisical
    # installs reporting ✗ instead of ✓. Codex R2 #131 catch.
    if [[ -n "${INFISICAL_CLIENT_ID:-}" ]] \
        || ([[ -f "${WALTER_CONFIG}/env" ]] && grep -qE '^INFISICAL_CLIENT_ID=.+' "${WALTER_CONFIG}/env" 2>/dev/null); then
      has_infisical_id=1
    fi
    if [[ "$has_infisical_id" -eq 1 ]]; then
      # Infisical runtime present. Plaintext file is either absent
      # (clean install) or still around (legacy, harmless but worth a
      # migration nudge). Either way the runtime check is green.
      if [[ -f "$secrets" ]]; then
        echo "warn"  # both paths present — migrate plaintext away
      else
        echo "ok"
      fi
    elif [[ -f "$secrets" ]]; then
      echo "warn"  # legacy plaintext only; Infisical migration pending
    else
      echo "fail"
    fi
  }

  # tier_check: wraps `check` with a tier number. Skips when a tier
  # filter is active and the check's tier > the filter (i.e. tier-3
  # check is skipped when running --tier 2).
  tier_check() {
    local n="$1"; shift
    if [[ -z "$tier_filter" ]] || [[ "$n" -le "$tier_filter" ]]; then
      check "$@"
    fi
  }

  echo "Walter-OS config:"
  tier_check 1 "WALTER_OS_HOME exists" test -d "$WALTER_OS_HOME"
  tier_check 1 "repo policy valid or absent" _doctor_repo_config_probe
  tier_check 1 "env file present" test -f "${WALTER_CONFIG}/env"
  # F8 / #123: secrets runtime check is three-state (ok / warn / fail).
  # ok = Infisical configured (preferred). warn = legacy plaintext
  # secrets.env exists (still works, plan migration). fail = neither.
  # Replaces the old `test -f .../secrets.env` tier_check which
  # false-FAILed on clean Infisical installs (no plaintext file is
  # the desired state).
  if [[ -z "$tier_filter" ]] || [[ 1 -le "$tier_filter" ]]; then
    check_three_state "secrets runtime configured" _secrets_runtime_probe \
      "migrate to Infisical machine identity (legacy plaintext secrets.env detected)"
  fi
  # shellcheck disable=SC2088,SC2016 # tildes are labels; single-quoted
  # `$HOME` / `$1` in bash -c is INTENTIONAL — that's the positional-arg
  # passing pattern from Codex R3 #124 that prevents WALTER_OS_HOME
  # interpolation injection. Expansion happens in the inner bash, not here.
  tier_check 1 '~/.claude/CLAUDE.md symlinked to walter-os' \
    bash -c '[[ -L "$HOME/.claude/CLAUDE.md" ]] && [[ "$(readlink "$HOME/.claude/CLAUDE.md")" == "$1"* ]]' \
    bash "$WALTER_OS_HOME"
  # shellcheck disable=SC2088,SC2016
  tier_check 1 '~/.codex/AGENTS.md symlinked to walter-os' \
    bash -c '[[ -L "$HOME/.codex/AGENTS.md" ]] && [[ "$(readlink "$HOME/.codex/AGENTS.md")" == "$1"* ]]' \
    bash "$WALTER_OS_HOME"
  # shellcheck disable=SC2088,SC2016
  tier_check 1 '~/.local/bin/walter-os symlinked' \
    bash -c '[[ -L "$HOME/.local/bin/walter-os" ]]'

  # Tier 2: local tooling — skills, MCP profile, audit cadence.
  # shellcheck disable=SC2088
  tier_check 2 '~/.claude/settings.json present' test -f "$CLAUDE_SETTINGS"
  # shellcheck disable=SC2088
  tier_check 2 'skills symlinked into ~/.claude/skills' \
    bash -c "ls -1 \"\$HOME/.claude/skills\" 2>/dev/null | grep -q ."
  tier_check 2 "audit ran today" test -f "${WALTER_CONFIG}/audit-${TODAY}.md"

  # Tier 3: VM-side credentials (validated locally, the actual service
  # health checks run from the VM via the tier-3.md prompt's verify
  # commands). We use a small helper to avoid `bash -c` wrappers
  # (shellcheck SC2016 flags single-quoted expansions even when that's
  # exactly what we want).
  _env_nonempty() { [[ -n "${!1:-}" ]]; }

  tier_check 3 "WALTER_DOMAIN env set (Tier III)" _env_nonempty WALTER_DOMAIN
  tier_check 3 "HCLOUD_TOKEN env set (Tier III)" _env_nonempty HCLOUD_TOKEN

  # Tier 4: Council prerequisites.
  tier_check 4 "trust-tiers.yml present (Tier IV)" \
    test -f "${WALTER_CONFIG}/trust-tiers.yml"
  # shellcheck disable=SC2016 # single-quoted bash -c is intentional —
  # positional-arg pattern prevents WALTER_OS_HOME interpolation injection.
  tier_check 4 "Council agent definitions present (Tier IV)" \
    bash -c 'ls -1 "$1/agents"/*.md 2>/dev/null | grep -q .' bash "$WALTER_OS_HOME"

  # CLI presence checks (tier 1 — needed for any agent install).
  echo
  echo "Required CLIs:"
  tier_check 1 "claude CLI in PATH" command -v claude
  tier_check 1 "codex CLI in PATH" command -v codex
  tier_check 1 "jq installed" command -v jq
  tier_check 1 "git installed" command -v git
  tier_check 1 "gh (GitHub CLI) installed" command -v gh

  echo
  echo "Bootstrap tooling (optional but expected):"
  tier_check 2 "Homebrew installed" command -v brew
  tier_check 2 "mise (runtime version manager)" command -v mise
  tier_check 2 "OrbStack / docker daemon" command -v docker
  tier_check 2 "ripgrep (rg)" command -v rg
  tier_check 2 "shellcheck" command -v shellcheck
  tier_check 2 "bats-core" command -v bats
  tier_check 2 "gitleaks (secret scan)" command -v gitleaks
  tier_check 2 "uvx (Python runner)" command -v uvx
  tier_check 2 "Solana CLI" command -v solana
  tier_check 2 "Anchor (Solana programs)" command -v anchor
  tier_check 2 "Maestro (mobile testing)" command -v maestro
  tier_check 2 "Tailscale" command -v tailscale

  echo
  if [[ "$warns" -gt 0 ]]; then
    echo "${ok} ok / ${warns} warn / ${issues} issues"
  else
    echo "${ok} ok / ${issues} issues"
  fi
  # Warns do NOT fail the doctor — they're informational nudges
  # (e.g. "migrate from plaintext secrets to Infisical"). Issues do.
  [[ "$issues" -eq 0 ]] || exit 1
}

# ---------- dispatch ----------

cmd="${1:-help}"
shift || true

# --version / -v aliases route to the existing `version` subcommand
# (which reads the canonical VERSION file via cmd_version). This keeps
# the source of truth in one place and preserves the pre-existing
# update-check behaviour (WALTER_OS_SKIP_UPDATE_CHECK, GitHub API
# call to fetch latest tag, _version_is_newer comparison, etc.).
case "$cmd" in
  --version|-v) cmd="version" ;;
esac

# Universal help: `walter-os <subcommand> -h|--help|help` → show top-level help
# (delegating subcommand-specific help to the subcommand's own dispatcher
# when it has one; otherwise the global help is the right answer since
# walter-os subcommand args are documented in the leading-comment block).
if [[ "${1:-}" =~ ^(-h|--help|help)$ ]]; then
  case "$cmd" in
    # Subcommands that delegate to scripts with their own help support:
    sync|upgrade|sync-repos|profile-bootstrap|onboard|secrets-identity-init|secrets-keychain-init|secrets-bootstrap|secrets-pull|syncthing-bootstrap|agent-memory|wiki|agents|lessons|spend|mode|new|bridge|overlay|egress|session|cap|pr-score|repo-config)
      ;; # let the subcommand handle it (passes through "$@")
    *)
      print_help; exit 0 ;;
  esac
fi

case "$cmd" in
  audit)          cmd_audit "$@" ;;
  status)         cmd_status "$@" ;;
  ack)            cmd_ack "$@" ;;
  baseline)       cmd_baseline "$@" ;;
  baseline-hooks) cmd_baseline_hooks "$@" ;;
  baseline-external-hooks) cmd_baseline_external_hooks "$@" ;;
  baseline-mcp-tools) cmd_baseline_mcp_tools "$@" ;;
  enable-hook)    cmd_enable_hook "$@" ;;
  disable-hook)   cmd_disable_hook "$@" ;;
  sync)               cmd_sync "$@" ;;
  upgrade)            cmd_upgrade "$@" ;;
  sync-repos)         cmd_sync_repos "$@" ;;
  profile)            cmd_profile "$@" ;;
  profile-bootstrap)  cmd_profile_bootstrap "$@" ;;
  onboard)            exec "${WALTER_OS_HOME}/scripts/walter/subcommands/onboard.sh" "$@" ;;
  secrets-pull)         cmd_secrets_pull "$@" ;;
  secrets-bootstrap)    cmd_secrets_bootstrap "$@" ;;
  secrets-identity-init) cmd_secrets_identity_init "$@" ;;
  secrets-keychain-init) cmd_secrets_keychain_init "$@" ;;
  secrets-status)       cmd_secrets_status "$@" ;;
  secrets-clear)        cmd_secrets_clear "$@" ;;
  syncthing-bootstrap) cmd_syncthing_bootstrap "$@" ;;
  agent-memory)       cmd_agent_memory "$@" ;;
  wiki)               cmd_wiki "$@" ;;
  spend)              cmd_spend "$@" ;;
  lessons)            cmd_lessons "$@" ;;
  mode)               cmd_mode "$@" ;;
  agents)             cmd_agents "$@" ;;
  new)                cmd_new "$@" ;;
  bridge)             exec "${WALTER_OS_HOME}/scripts/walter/subcommands/bridge.sh" "$@" ;;
  overlay)            exec "${WALTER_OS_HOME}/scripts/walter/subcommands/overlay.sh" "$@" ;;
  egress)             cmd_egress "$@" ;;
  session)            exec "${WALTER_OS_HOME}/scripts/walter/subcommands/session.sh" "$@" ;;
  cap)                exec "${WALTER_OS_HOME}/scripts/walter/subcommands/cap.sh" "$@" ;;
  content)            cmd_content "$@" ;;
  analyst)            cmd_content analyst "$@" ;;
  pr-title)           exec "${WALTER_OS_HOME}/scripts/walter/subcommands/pr-title.sh" "$@" ;;
  pr-score)           exec bash "${WALTER_OS_HOME}/scripts/walter/subcommands/pr-score.sh" "$@" ;;
  repo-config)        exec bash "${WALTER_OS_HOME}/scripts/walter/subcommands/repo-config.sh" "$@" ;;
  version)            cmd_version "$@" ;;
  doctor)             cmd_doctor "$@" ;;
  uninstall)          cmd_uninstall "$@" ;;
  -h|--help|help) print_help ;;
  *)
    echo "walter-os: unknown command: $cmd" >&2
    print_help
    exit 2
    ;;
esac
