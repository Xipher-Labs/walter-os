# ---------- spend (LiteLLM cost attribution reports) ----------

cmd_spend_report() {
  require_jq
  local mode="" last="7d" start_date end_date

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --by-agent) mode="agent"; shift ;;
      --by-task)  mode="task";  shift ;;
      --last)     last="${2:-7d}"; shift 2 ;;
      -h|--help|help)
        cat <<SPEND_USAGE
Usage: walter-os spend report --by-agent --last 7d
       walter-os spend report --by-task  --last 7d

Options:
  --by-agent   Group spend by agent (default if no mode given)
  --by-task    Group spend by task (top-20 most expensive)
               Note: AGENT column shows '-' — LiteLLM group_by=task_id
               does not expose agent_id in the same response. Use
               --by-agent for per-agent breakdowns.
  --last <N>d  Reporting window in days (default: 7d)

Requires: LITELLM_BASE_URL and LITELLM_API_KEY env vars.
SPEND_USAGE
        return 0
        ;;
      *) shift ;;
    esac
  done

  # Default mode
  [[ -z "$mode" ]] && mode="agent"

  # Compute date range
  local spend_lib="${WALTER_OS_HOME}/scripts/agents/lib/spend.sh"
  if [[ ! -f "$spend_lib" ]]; then
    echo "walter-os spend: spend.sh library not found at $spend_lib" >&2
    exit 3
  fi

  # shellcheck disable=SC1090
  source "$spend_lib"

  local days; days=$(_spend_parse_last_flag "$last")
  end_date="$(_spend_date_offset 0)"
  start_date="$(_spend_date_offset "$days")"

  echo "Spend report: ${start_date} → ${end_date} (by ${mode})"
  echo

  case "$mode" in
    agent) spend_report_by_agent "$start_date" "$end_date" ;;
    task)  spend_report_by_task  "$start_date" "$end_date" ;;
  esac
}

cmd_spend() {
  local sub="${1:-report}"
  shift || true
  case "$sub" in
    report) cmd_spend_report "$@" ;;
    -h|--help|help)
      echo "Usage: walter-os spend <subcommand>"
      echo "  report  Print spend report (see: walter-os spend report --help)"
      ;;
    *) echo "walter-os spend: unknown subcommand '$sub'" >&2; exit 2 ;;
  esac
}

# ---------- lessons (cross-agent learning broker) ----------

cmd_lessons() {
  local sub="${1:-list}"
  shift || true

  local lessons_lib="${WALTER_OS_HOME}/scripts/agents/lib/lessons.sh"
  if [[ ! -f "$lessons_lib" ]]; then
    echo "walter-os lessons: lessons.sh not found at $lessons_lib" >&2
    echo "  Run install.sh to reinstall walter-os." >&2
    exit 3
  fi
  # shellcheck disable=SC1090
  source "$lessons_lib"

  case "$sub" in
    list)
      lessons_list "$@"
      ;;
    query)
      local query_text="${1:-}"
      shift || true
      if [[ -z "$query_text" ]]; then
        echo "walter-os lessons query: query text required" >&2
        echo "Usage: walter-os lessons query <text> [--limit N]" >&2
        exit 2
      fi
      local limit=5
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --limit) limit="${2:-5}"; shift 2 ;;
          *) shift ;;
        esac
      done
      # shellcheck disable=SC2034
      _LESSON_TOP_K="$limit"
      lesson_query "$query_text" ""
      ;;
    rate)
      local id="${1:-}"
      local score="${2:-}"
      if [[ -z "$id" || -z "$score" ]]; then
        echo "walter-os lessons rate: id and score required" >&2
        echo "Usage: walter-os lessons rate <id> <0.0..1.0>" >&2
        exit 2
      fi
      lessons_rate "$id" "$score"
      ;;
    prune)
      local dry_run=0 older_than="30d"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --dry-run) dry_run=1; shift ;;
          --older-than) older_than="$2"; shift 2 ;;
          *) shift ;;
        esac
      done
      local days="${older_than//d/}"
      lessons_init || return 1
      local where="WHERE created_at < datetime('now', '-${days} days')"
      local count
      count="$("${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "SELECT COUNT(*) FROM lessons ${where};" 2>/dev/null || echo 0)"
      echo "Lessons older than ${older_than}: ${count}"
      if [[ "$dry_run" -eq 0 && "$count" -gt 0 ]]; then
        "${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "DELETE FROM lessons ${where};" 2>/dev/null
        echo "Pruned $count lessons."
      else
        [[ "$dry_run" -eq 1 ]] && echo "(dry-run — no changes made)"
      fi
      ;;
    stats)
      lessons_init || return 1
      local total oldest most_accessed
      total="$("${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "SELECT COUNT(*) FROM lessons;" 2>/dev/null || echo 0)"
      echo "Lessons stats:"
      echo "  Total: $total"
      if [[ "$total" -gt 0 ]]; then
        echo "  Per agent:"
        "${_LESSONS_SQLITE3:-sqlite3}" -separator '|' "$LESSONS_DB" \
          "SELECT source_agent, COUNT(*) FROM lessons GROUP BY source_agent ORDER BY 2 DESC;" \
          2>/dev/null | while IFS='|' read -r agent cnt; do
            printf "    %-14s %s\n" "$agent" "$cnt"
          done
        oldest="$("${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "SELECT created_at FROM lessons ORDER BY created_at ASC LIMIT 1;" 2>/dev/null || echo '-')"
        most_accessed="$("${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "SELECT headline FROM lessons ORDER BY created_at DESC LIMIT 1;" 2>/dev/null || echo '-')"
        echo "  Oldest: $oldest"
        echo "  Latest: $most_accessed"
      fi
      ;;
    -h|--help|help)
      cat <<LESSONS_USAGE
Usage: walter-os lessons <subcommand>

Subcommands:
  list [--agent <name>] [--last <Nd>] [--tag <tag>]
                  List lessons (table view)
  query <text> [--limit N]
                  Embed query and return top-N similar lessons (JSON)
  rate <id> <score>
                  Update confidence for a lesson (0.0–1.0)
  prune [--older-than <Nd>] [--dry-run]
                  Delete old lessons
  stats           Total count + per-agent breakdown

DB: \${LESSONS_DB:-~/.config/walter-os/lessons.db}
Spec: docs/specs/walter-council-v2.md — T-14, Improvement 4
LESSONS_USAGE
      ;;
    *)
      echo "walter-os lessons: unknown subcommand '$sub'" >&2
      echo "  Run: walter-os lessons help" >&2
      exit 2
      ;;
  esac
}

# ---------- mode (Walter Council operating mode: consensus, etc.) ----------

cmd_mode() {
  require_jq
  local mode_lib="${WALTER_OS_HOME}/scripts/agents/lib/mode.sh"
  if [[ ! -f "$mode_lib" ]]; then
    echo "walter-os mode: mode.sh library not found at $mode_lib" >&2
    exit 3
  fi
  # shellcheck disable=SC1090
  source "$mode_lib"

  local sub="${1:-status}"
  shift || true

  case "$sub" in
    consensus)
      local action="${1:-status}"
      shift || true
      case "$action" in
        on)
          mode_consensus_set on "$@"
          echo "Consensus mode: ON"
          local threshold
          threshold=$(jq -r '.voting_threshold // 3' "$MODE_FILE" 2>/dev/null || echo 3)
          local since
          since=$(jq -r '.since // ""' "$MODE_FILE" 2>/dev/null || echo "")
          echo "  since: ${since}"
          echo "  voting_threshold: ${threshold}"
          ;;
        off)
          mode_consensus_set off
          echo "Consensus mode: OFF"
          ;;
        status)
          if mode_consensus_is_on 2>/dev/null; then
            local threshold since
            threshold=$(jq -r '.voting_threshold // 3' "$MODE_FILE" 2>/dev/null || echo 3)
            since=$(jq -r '.since // ""' "$MODE_FILE" 2>/dev/null || echo "")
            echo "Consensus mode: ON (since ${since}, threshold: ${threshold})"
          else
            echo "Consensus mode: OFF"
          fi
          ;;
        *)
          echo "walter-os mode consensus: unknown action '$action'" >&2
          echo "  Usage: walter-os mode consensus on|off|status [--threshold N]" >&2
          exit 2
          ;;
      esac
      ;;
    -h|--help|help)
      cat <<MODE_USAGE
Usage: walter-os mode <subcommand>

Subcommands:
  consensus on [--threshold N]  Enable consensus mode (threshold=3 default)
  consensus off                 Disable consensus mode
  consensus status              Show current consensus mode status

Spec: docs/specs/walter-council-v2.md — Improvement 9 (T-32)
MODE_USAGE
      ;;
    *)
      echo "walter-os mode: unknown subcommand '$sub'" >&2
      echo "  Run: walter-os mode help" >&2
      exit 2
      ;;
  esac
}

