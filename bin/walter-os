# ---------- spend (LiteLLM cost attribution reports) ----------

cmd_spend_report() {
  require_jq
  local mode="" last="7d" start_date end_date

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --by-agent) mode="agent"; shift ;;
      --by-task)  mode="task";  shift ;;
      --last)     last="${2:-7d}"; shift 2 ;;
      -h|--help|help)
        cat <<SPEND_USAGE
Usage: walter-os spend report --by-agent --last 7d
       walter-os spend report --by-task  --last 7d

Options:
  --by-agent   Group spend by agent (default if no mode given)
  --by-task    Group spend by task (top-20 most expensive)
               Note: AGENT column shows '-' — LiteLLM group_by=task_id
               does not expose agent_id in the same response. Use
               --by-agent for per-agent breakdowns.
  --last <N>d  Reporting window in days (default: 7d)

Requires: LITELLM_BASE_URL and LITELLM_API_KEY env vars.
SPEND_USAGE
        return 0
        ;;
      *) shift ;;
    esac
  done

  # Default mode
  [[ -z "$mode" ]] && mode="agent"

  # Compute date range
  local spend_lib="${WALTER_OS_HOME}/scripts/agents/lib/spend.sh"
  if [[ ! -f "$spend_lib" ]]; then
    echo "walter-os spend: spend.sh library not found at $spend_lib" >&2
    exit 3
  fi

  # shellcheck disable=SC1090
  source "$spend_lib"

  local days; days=$(_spend_parse_last_flag "$last")
  end_date="$(_spend_date_offset 0)"
  start_date="$(_spend_date_offset "$days")"

  echo "Spend report: ${start_date} → ${end_date} (by ${mode})"
  echo

  case "$mode" in
    agent) spend_report_by_agent "$start_date" "$end_date" ;;
    task)  spend_report_by_task  "$start_date" "$end_date" ;;
  esac
}

cmd_spend() {
  local sub="${1:-report}"
  shift || true
  case "$sub" in
    report) cmd_spend_report "$@" ;;
    -h|--help|help)
      echo "Usage: walter-os spend <subcommand>"
      echo "  report  Print spend report (see: walter-os spend report --help)"
      ;;
    *) echo "walter-os spend: unknown subcommand '$sub'" >&2; exit 2 ;;
  esac
}

# ---------- lessons (cross-agent learning broker) ----------

cmd_lessons() {
  local sub="${1:-list}"
  shift || true

  local lessons_lib="${WALTER_OS_HOME}/scripts/agents/lib/lessons.sh"
  if [[ ! -f "$lessons_lib" ]]; then
    echo "walter-os lessons: lessons.sh not found at $lessons_lib" >&2
    echo "  Run install.sh to reinstall walter-os." >&2
    exit 3
  fi
  # shellcheck disable=SC1090
  source "$lessons_lib"

  case "$sub" in
    list)
      lessons_list "$@"
      ;;
    query)
      local query_text="${1:-}"
      shift || true
      if [[ -z "$query_text" ]]; then
        echo "walter-os lessons query: query text required" >&2
        echo "Usage: walter-os lessons query <text> [--limit N]" >&2
        exit 2
      fi
      local limit=5
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --limit) limit="${2:-5}"; shift 2 ;;
          *) shift ;;
        esac
      done
      # shellcheck disable=SC2034
      _LESSON_TOP_K="$limit"
      lesson_query "$query_text" ""
      ;;
    rate)
      local id="${1:-}"
      local score="${2:-}"
      if [[ -z "$id" || -z "$score" ]]; then
        echo "walter-os lessons rate: id and score required" >&2
        echo "Usage: walter-os lessons rate <id> <0.0..1.0>" >&2
        exit 2
      fi
      lessons_rate "$id" "$score"
      ;;
    prune)
      local dry_run=0 older_than="30d"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --dry-run) dry_run=1; shift ;;
          --older-than) older_than="$2"; shift 2 ;;
          *) shift ;;
        esac
      done
      local days="${older_than//d/}"
      lessons_init || return 1
      local where="WHERE created_at < datetime('now', '-${days} days')"
      local count
      count="$("${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "SELECT COUNT(*) FROM lessons ${where};" 2>/dev/null || echo 0)"
      echo "Lessons older than ${older_than}: ${count}"
      if [[ "$dry_run" -eq 0 && "$count" -gt 0 ]]; then
        "${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "DELETE FROM lessons ${where};" 2>/dev/null
        echo "Pruned $count lessons."
      else
        [[ "$dry_run" -eq 1 ]] && echo "(dry-run — no changes made)"
      fi
      ;;
    stats)
      lessons_init || return 1
      local total oldest most_accessed
      total="$("${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "SELECT COUNT(*) FROM lessons;" 2>/dev/null || echo 0)"
      echo "Lessons stats:"
      echo "  Total: $total"
      if [[ "$total" -gt 0 ]]; then
        echo "  Per agent:"
        "${_LESSONS_SQLITE3:-sqlite3}" -separator '|' "$LESSONS_DB" \
          "SELECT source_agent, COUNT(*) FROM lessons GROUP BY source_agent ORDER BY 2 DESC;" \
          2>/dev/null | while IFS='|' read -r agent cnt; do
            printf "    %-14s %s\n" "$agent" "$cnt"
          done
        oldest="$("${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "SELECT created_at FROM lessons ORDER BY created_at ASC LIMIT 1;" 2>/dev/null || echo '-')"
        most_accessed="$("${_LESSONS_SQLITE3:-sqlite3}" "$LESSONS_DB" "SELECT headline FROM lessons ORDER BY created_at DESC LIMIT 1;" 2>/dev/null || echo '-')"
        echo "  Oldest: $oldest"
        echo "  Latest: $most_accessed"
      fi
      ;;
    -h|--help|help)
      cat <<LESSONS_USAGE
Usage: walter-os lessons <subcommand>

Subcommands:
  list [--agent <name>] [--last <Nd>] [--tag <tag>]
                  List lessons (table view)
  query <text> [--limit N]
                  Embed query and return top-N similar lessons (JSON)
  rate <id> <score>
                  Update confidence for a lesson (0.0–1.0)
  prune [--older-than <Nd>] [--dry-run]
                  Delete old lessons
  stats           Total count + per-agent breakdown

DB: \${LESSONS_DB:-~/.config/walter-os/lessons.db}
Spec: docs/specs/walter-council-v2.md — T-14, Improvement 4
LESSONS_USAGE
      ;;
    *)
      echo "walter-os lessons: unknown subcommand '$sub'" >&2
      echo "  Run: walter-os lessons help" >&2
      exit 2
      ;;
  esac
}

# ---------- mode (Walter Council operating mode: consensus, etc.) ----------

cmd_mode() {
  require_jq
  local mode_lib="${WALTER_OS_HOME}/scripts/agents/lib/mode.sh"
  if [[ ! -f "$mode_lib" ]]; then
    echo "walter-os mode: mode.sh library not found at $mode_lib" >&2
    exit 3
  fi
  # shellcheck disable=SC1090
  source "$mode_lib"

  local sub="${1:-status}"
  shift || true

  case "$sub" in
    consensus)
      local action="${1:-status}"
      shift || true
      case "$action" in
        on)
          mode_consensus_set on "$@"
          echo "Consensus mode: ON"
          local threshold
          threshold=$(jq -r '.voting_threshold // 3' "$MODE_FILE" 2>/dev/null || echo 3)
          local since
          since=$(jq -r '.since // ""' "$MODE_FILE" 2>/dev/null || echo "")
          echo "  since: ${since}"
          echo "  voting_threshold: ${threshold}"
          ;;
        off)
          mode_consensus_set off
          echo "Consensus mode: OFF"
          ;;
        status)
          if mode_consensus_is_on 2>/dev/null; then
            local threshold since
            threshold=$(jq -r '.voting_threshold // 3' "$MODE_FILE" 2>/dev/null || echo 3)
            since=$(jq -r '.since // ""' "$MODE_FILE" 2>/dev/null || echo "")
            echo "Consensus mode: ON (since ${since}, threshold: ${threshold})"
          else
            echo "Consensus mode: OFF"
          fi
          ;;
        *)
          echo "walter-os mode consensus: unknown action '$action'" >&2
          echo "  Usage: walter-os mode consensus on|off|status [--threshold N]" >&2
          exit 2
          ;;
      esac
      ;;
    -h|--help|help)
      cat <<MODE_USAGE
Usage: walter-os mode <subcommand>

Subcommands:
  consensus on [--threshold N]  Enable consensus mode (threshold=3 default)
  consensus off                 Disable consensus mode
  consensus status              Show current consensus mode status

Spec: docs/specs/walter-council-v2.md — Improvement 9 (T-32)
MODE_USAGE
      ;;
    *)
      echo "walter-os mode: unknown subcommand '$sub'" >&2
      echo "  Run: walter-os mode help" >&2
      exit 2
      ;;
  esac
}

# ---------- agents (Walter Council multi-agent autonomy) ----------

cmd_agents() {
  exec "${WALTER_OS_HOME}/scripts/agents/main.sh" "$@"
}

# ---------- new (project induction) ----------

cmd_new() {
  local subcmd="${1:-}"
  shift || true

  if [[ "$subcmd" != "project" ]]; then
    if [[ "$subcmd" =~ ^(-h|--help|help)$ ]]; then
      cat <<NEW_USAGE
Usage: walter-os new <subcommand> [options]

Subcommands:
  project <type> <name> [opts]    Start project induction interview
                                  Types: webapp | service | solana | hackathon | personal

Project options:
  --output-dir <path>             Write charter + AGENTS.md here (default: docs/specs/)
  --skip-plane                    Skip Plane epic creation
  --non-interactive               Non-interactive mode; requires --answers-file
  --answers-file <path>           YAML with pre-filled answers (for scripted use)

Examples:
  walter-os new project webapp my-app
  walter-os new project solana anchor-staking --output-dir /tmp/test

Spec: docs/specs/walter-council-v2.md — Improvement 6 (T-24)
NEW_USAGE
      exit 0
    fi
    echo "Usage: walter-os new project <type> <name> [options]" >&2
    echo "  Types: webapp | service | solana | hackathon | personal" >&2
    [[ -z "$subcmd" ]] || echo "  Unknown subcommand: $subcmd" >&2
    exit 2
  fi

  # `new project <type> <name> [opts...]`
  local project_type="${1:-}"
  local project_name="${2:-}"

  # Handle --help before validation
  if [[ "$project_type" =~ ^(-h|--help|help)$ ]]; then
    cmd_new --help
    exit 0
  fi

  if [[ -z "$project_type" || -z "$project_name" ]]; then
    echo "Usage: walter-os new project <type> <name> [options]" >&2
    echo "  Types: webapp | service | solana | hackathon | personal" >&2
    exit 2
  fi

  # Validate type (same list as induction.sh)
  local valid_types=("webapp" "service" "solana" "hackathon" "personal")
  local type_ok=0
  for t in "${valid_types[@]}"; do
    [[ "$project_type" == "$t" ]] && type_ok=1 && break
  done
  if [[ "$type_ok" -eq 0 ]]; then
    echo "walter-os new project: invalid type '$project_type'." >&2
    echo "  Valid types: ${valid_types[*]}" >&2
    exit 2
  fi

  # Validate name: alphanumeric+hyphens, 1-50 chars
  if ! echo "$project_name" | grep -qE '^[a-zA-Z0-9][a-zA-Z0-9-]{0,49}$'; then
    echo "walter-os new project: invalid name '$project_name'." >&2
    echo "  Name must be alphanumeric+hyphens, ≤ 50 chars." >&2
    exit 2
  fi

  shift 2 || true  # remove type and name; pass remaining opts to induction.sh

  local induction="${WALTER_OS_HOME}/skills/project-induction/scripts/induction.sh"
  if [[ ! -x "$induction" ]]; then
    echo "walter-os new project: induction.sh not found at $induction" >&2
    echo "  Run install.sh to ensure skills are installed." >&2
    exit 3
  fi

  exec "$induction" \
    --project-type "$project_type" \
    --project-name "$project_name" \
    "$@"
}

# ---------- content analytics (Phase V — devrel-analyst) ----------

cmd_content() {
  local sub="${1:-stats}"
  shift || true
  case "$sub" in
    stats)
      # walter-os content stats [--since 30d] [--dry-run]
      # Delegates to devrel-analyst skill query.py
      local query_py="${WALTER_OS_HOME}/skills/devrel-analyst/scripts/query.py"
      if [[ ! -f "$query_py" ]]; then
        echo "walter-os content: devrel-analyst skill not found at $query_py" >&2
        exit 3
      fi
      python3 "$query_py" top_threads "$@"
      ;;
    analyst)
      # walter-os content analyst <query> [args]
      # Direct passthrough to devrel-analyst query.py
      local query_py="${WALTER_OS_HOME}/skills/devrel-analyst/scripts/query.py"
      if [[ ! -f "$query_py" ]]; then
        echo "walter-os content: devrel-analyst skill not found at $query_py" >&2
        exit 3
      fi
      python3 "$query_py" "$@"
      ;;
    prereqs)
      # walter-os content prereqs — check Singer + API prereqs
      local check="${WALTER_OS_HOME}/setup/walter-host/singer/check-prereqs.sh"
      if [[ ! -x "$check" ]]; then
        echo "walter-os content: check-prereqs.sh not found" >&2
        exit 3
      fi
      bash "$check" "$@"
      ;;
    -h|--help|help)
      echo "Usage: walter-os content <subcommand>"
      echo "  stats [--since 30d] [--dry-run]    Top threads by engagement"
      echo "  analyst <query> [args]              Run any devrel-analyst query"
      echo "    Queries: top_threads, optimal_hours, pattern_match,"
      echo "             roi_per_content_piece, weekly_digest"
      echo "  prereqs                             Check Singer tap + API prereqs"
      echo ""
      echo "Examples:"
      echo "  walter-os content stats --since 7d --limit 10"
      echo "  walter-os content analyst pattern_match --topic solana-rpc"
      echo "  walter-os content analyst weekly_digest --dry-run"
      ;;
    *)
      echo "walter-os content: unknown subcommand '$sub'" >&2
      echo "  Run: walter-os content help" >&2
      exit 2
      ;;
  esac
}

# ---------- version ----------

cmd_version() {
  # Source _version_is_newer from the shared lib on first use (lazy).
  # Keeps the blast radius small: only 'version' fails if the lib is absent.
  # shellcheck source=/dev/null
  source "${WALTER_OS_HOME}/scripts/walter/lib/version-compare.sh" 2>/dev/null \
    || { echo "walter-os: missing scripts/walter/lib/version-compare.sh" >&2; exit 1; }

  local version_file="${WALTER_OS_HOME}/VERSION"
  if [[ ! -f "$version_file" ]]; then
    echo "walter-os: VERSION file not found at $version_file" >&2
    exit 3
  fi
  local current
  current="$(cat "$version_file")"
  current="${current//[$'\r\n\t ']/}"  # strip any whitespace

  echo "Walter-OS v${current}"

  # Update check: skip if WALTER_OS_SKIP_UPDATE_CHECK is set (e.g., tests),
  # or if curl is unavailable.
  if [[ "${WALTER_OS_SKIP_UPDATE_CHECK:-}" == "1" ]]; then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  local update_repo="${WALTER_OS_UPDATE_REPO:-xipher-labs/walter-os}"
  if [[ ! "$update_repo" =~ ^[^/]+/[^/]+$ ]]; then
    echo "WARN: WALTER_OS_UPDATE_REPO must be 'owner/repo' format, got: ${update_repo}. Update check skipped." >&2
    return 0
  fi
  local owner="${update_repo%/*}"
  local repo="${update_repo#*/}"
  local api_url="https://api.github.com/repos/${owner}/${repo}/releases/latest"
  local auth_header=""
  [[ -n "${GITHUB_TOKEN:-}" ]] && auth_header="Authorization: Bearer ${GITHUB_TOKEN}"

  local latest_tag
  if [[ -n "$auth_header" ]]; then
    latest_tag="$(curl -fsSL --max-time 5 --connect-timeout 3 -H "$auth_header" "$api_url" 2>/dev/null \
      | grep '"tag_name"' | head -1 | sed 's/.*"tag_name": *"\(.*\)".*/\1/')"
  else
    latest_tag="$(curl -fsSL --max-time 5 --connect-timeout 3 "$api_url" 2>/dev/null \
      | grep '"tag_name"' | head -1 | sed 's/.*"tag_name": *"\(.*\)".*/\1/')"
  fi

  if [[ -z "$latest_tag" ]]; then
    return 0  # network unavailable or API rate-limited — silent
  fi

  local latest_version="${latest_tag#v}"  # strip leading 'v' if present

  if _version_is_newer "$latest_version" "$current"; then
    echo "(update available: v${latest_version} — https://github.com/${owner}/${repo}/releases/tag/${latest_tag})"
  else
    echo "(up to date)"
  fi
}

# ---------- doctor ----------

cmd_doctor() {
  echo "Walter-OS doctor"
  echo

  local ok=0 issues=0

  check() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      printf "  ✓ %s\n" "$label"
      ok=$((ok + 1))
    else
      printf "  ✗ %s\n" "$label"
      issues=$((issues + 1))
    fi
  }

  echo "Walter-OS config:"
  check "WALTER_OS_HOME exists" test -d "$WALTER_OS_HOME"
  check "env file present" test -f "${WALTER_CONFIG}/env"
  check "secrets template present" test -f "${WALTER_CONFIG}/secrets.env"
  # shellcheck disable=SC2088 # tildes here are labels, not paths
  check '~/.claude/settings.json present' test -f "$CLAUDE_SETTINGS"
  # shellcheck disable=SC2088
  check '~/.claude/CLAUDE.md symlinked to walter-os' \
    bash -c "[[ -L \"\$HOME/.claude/CLAUDE.md\" ]] && [[ \"\$(readlink \"\$HOME/.claude/CLAUDE.md\")\" == \"$WALTER_OS_HOME\"* ]]"
  # shellcheck disable=SC2088
  check '~/.codex/AGENTS.md symlinked to walter-os' \
    bash -c "[[ -L \"\$HOME/.codex/AGENTS.md\" ]] && [[ \"\$(readlink \"\$HOME/.codex/AGENTS.md\")\" == \"$WALTER_OS_HOME\"* ]]"
  # shellcheck disable=SC2088
  check 'skills symlinked into ~/.claude/skills' \
    bash -c "ls -1 \"\$HOME/.claude/skills\" 2>/dev/null | grep -q ."
  check "audit ran today" test -f "${WALTER_CONFIG}/audit-${TODAY}.md"

  echo
  echo "Required CLIs:"
  check "claude CLI in PATH" command -v claude
  check "codex CLI in PATH" command -v codex
  check "jq installed" command -v jq
  check "git installed" command -v git
  check "gh (GitHub CLI) installed" command -v gh

  echo
  echo "Bootstrap tooling (optional but expected):"
  check "Homebrew installed" command -v brew
  check "mise (runtime version manager)" command -v mise
  check "OrbStack / docker daemon" command -v docker
  check "ripgrep (rg)" command -v rg
  check "shellcheck" command -v shellcheck
  check "bats-core" command -v bats
  check "gitleaks (secret scan)" command -v gitleaks
  check "uvx (Python runner)" command -v uvx
  check "Solana CLI" command -v solana
  check "Anchor (Solana programs)" command -v anchor
  check "Maestro (mobile testing)" command -v maestro
  check "Tailscale" command -v tailscale

  echo
  echo "${ok} ok / ${issues} issues"
  [[ "$issues" -eq 0 ]] || exit 1
}

# ---------- dispatch ----------

cmd="${1:-help}"
shift || true

# Universal help: `walter-os <subcommand> -h|--help|help` → show top-level help
# (delegating subcommand-specific help to the subcommand's own dispatcher
# when it has one; otherwise the global help is the right answer since
# walter-os subcommand args are documented in the leading-comment block).
if [[ "${1:-}" =~ ^(-h|--help|help)$ ]]; then
  case "$cmd" in
    # Subcommands that delegate to scripts with their own help support:
    sync|sync-repos|profile-bootstrap|secrets-identity-init|secrets-keychain-init|secrets-bootstrap|secrets-pull|syncthing-bootstrap|agent-memory|wiki|agents|lessons|spend|mode|new|bridge)
      ;; # let the subcommand handle it (passes through "$@")
    *)
      print_help; exit 0 ;;
  esac
fi

case "$cmd" in
  audit)          cmd_audit "$@" ;;
  status)         cmd_status "$@" ;;
  ack)            cmd_ack "$@" ;;
  baseline)       cmd_baseline "$@" ;;
  baseline-hooks) cmd_baseline_hooks "$@" ;;
  enable-hook)    cmd_enable_hook "$@" ;;
  disable-hook)   cmd_disable_hook "$@" ;;
  sync)               cmd_sync "$@" ;;
  sync-repos)         cmd_sync_repos "$@" ;;
  profile)            cmd_profile "$@" ;;
  profile-bootstrap)  cmd_profile_bootstrap "$@" ;;
  secrets-pull)         cmd_secrets_pull "$@" ;;
  secrets-bootstrap)    cmd_secrets_bootstrap "$@" ;;
  secrets-identity-init) cmd_secrets_identity_init "$@" ;;
  secrets-keychain-init) cmd_secrets_keychain_init "$@" ;;
  secrets-status)       cmd_secrets_status "$@" ;;
  secrets-clear)        cmd_secrets_clear "$@" ;;
  syncthing-bootstrap) cmd_syncthing_bootstrap "$@" ;;
  agent-memory)       cmd_agent_memory "$@" ;;
  wiki)               cmd_wiki "$@" ;;
  spend)              cmd_spend "$@" ;;
  lessons)            cmd_lessons "$@" ;;
  mode)               cmd_mode "$@" ;;
  agents)             cmd_agents "$@" ;;
  new)                cmd_new "$@" ;;
  bridge)             exec "${WALTER_OS_HOME}/scripts/walter/subcommands/bridge.sh" "$@" ;;
  content)            cmd_content "$@" ;;
  analyst)            cmd_content analyst "$@" ;;
  pr-title)           exec "${WALTER_OS_HOME}/scripts/walter/subcommands/pr-title.sh" "$@" ;;
  version)            cmd_version "$@" ;;
  doctor)             cmd_doctor "$@" ;;
  -h|--help|help) print_help ;;
  *)
    echo "walter-os: unknown command: $cmd" >&2
    print_help
    exit 2
    ;;
esac
