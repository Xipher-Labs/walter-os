# Walter-VM Singer Taps — Environment Config Example
#
# Copy to .env (gitignored) and fill in real values.
# Actual secrets go in Infisical workspace 'walter-os', env 'dev'.
#
# Refs: docs/specs/devrel-analytics-stack.md (V-prereq-9)
# Refs: docs/operational/council-v2-prereqs.md (V-prereq-5, V-prereq-9)

# ── Postgres analytics target ─────────────────────────────────────────────────
ANALYTICS_PG_PASS=CHANGE_ME
ANALYTICS_DB_URL=postgresql://analytics:CHANGE_ME@localhost:5433/walter_devrel_analytics

# ── Google Ads (tap-google-ads) ───────────────────────────────────────────────
# Prereq: V-prereq-1 (Developer Token, 3-5 days approval)
GOOGLE_ADS_DEVELOPER_TOKEN=PENDING_APPROVAL
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # Manager account ID (no dashes)
GOOGLE_ADS_CUSTOMER_ID=         # Advertiser account ID

# ── Meta (tap-facebook) ──────────────────────────────────────────────────────
# Prereq: V-prereq-2 (App Review, 5-15 days)
META_APP_ID=PENDING_APP_REVIEW
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── LinkedIn (tap-linkedin-ads) ───────────────────────────────────────────────
# Prereq: V-prereq-3 (Marketing Developer Platform, Tier 3, may take months)
LINKEDIN_ACCESS_TOKEN=PENDING_APPROVAL
LINKEDIN_AD_ACCOUNT_IDS=        # comma-separated account IDs

# ── Google Analytics 4 (tap-google-analytics) — optional ─────────────────────
GA4_PROPERTY_ID=
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REFRESH_TOKEN=

# ── Singer state files directory ──────────────────────────────────────────────
# gitignored — stores incremental sync state between tap runs
SINGER_STATE_DIR=${HOME}/.config/walter-os/singer-state
