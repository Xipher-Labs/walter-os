# n8n .env — copy to .env on the VM (NOT in git).
# deploy.sh generates this with random secrets on first run.

N8N_HOST=n8n.${WALTER_DOMAIN}
N8N_TIMEZONE=America/Argentina/Buenos_Aires

# Postgres password — generate: openssl rand -hex 24
N8N_PG_PASS=

# Encryption key (encrypts stored credentials inside n8n DB)
# generate: openssl rand -hex 32
# CRITICAL: rotating this key breaks all stored credentials in n8n.
# Back it up to Infisical workspace `walter-vm-internal` env=prod.
N8N_ENCRYPTION_KEY=

# Basic-auth defense-in-depth (P1-03). n8n's built-in basic auth runs
# BEHIND Cloudflare Access as a second authentication layer (not MFA;
# a second independent credential check). Both vars REQUIRED — the
# compose.yml uses `${VAR:?...}` so the container refuses to boot if
# either is unset.
#   generate: openssl rand -hex 16 (for password)
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
