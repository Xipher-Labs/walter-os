# PostHog — environment template
# Vendored from operator VM /opt/posthog (2026-05-12).
# Copy to .env and fill in real values before running docker compose up -d.
# Secret-of-truth: Infisical workspace=walter-os env=prod path=/services/posthog/
#
# See: https://posthog.com/docs/self-host/deploy/hobby

# ─── Domain ──────────────────────────────────────────────────────────────
# PostHog is served at posthog.${WALTER_DOMAIN}
WALTER_DOMAIN=

# ─── PostHog image ────────────────────────────────────────────────────────
# Upstream publishes :master; pin to a digest for reproducible deploys.
# Find current digest: docker pull ghcr.io/posthog/posthog:master && docker inspect --format='{{index .RepoDigests 0}}' ghcr.io/posthog/posthog:master
REGISTRY_URL=ghcr.io/posthog/posthog
POSTHOG_APP_TAG=master
# For the node services (plugins, ingestion-*, recording-api, etc.):
POSTHOG_NODE_TAG=latest

# ─── Secrets ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
POSTHOG_SECRET=

# Generate: openssl rand -hex 16
POSTHOG_DB_PASS=

# Generate: openssl rand -hex 16
# Format: comma-separated Fernet keys; first is active, rest are for decryption rotation.
ENCRYPTION_SALT_KEYS=

# ─── Optional ────────────────────────────────────────────────────────────
# Opt out of PostHog telemetry about your self-hosted install (default: false)
OPT_OUT_CAPTURE=true

# SeaweedFS container name (shared with standalone seaweedfs service)
SEAWEEDFS_DOCKER_NAME=seaweedfs-main
