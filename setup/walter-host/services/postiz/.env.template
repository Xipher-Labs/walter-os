# Postiz — environment template
# Harmonized from feat/social-pipeline branch (2026-05-12).
#
# Copy to .env and fill in real values before running docker compose up -d.
# Secret-of-truth: Infisical workspace=walter-os env=prod path=/services/postiz/
#
# See: docs/operational/postiz-analytics-export.md

# ─── Generated secrets ────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
POSTIZ_JWT_SECRET=

# Generate: openssl rand -hex 16
POSTIZ_PG_PASS=

# ─── Public URL ──────────────────────────────────────────────────────────
# Postiz is served at postiz.${WALTER_DOMAIN}
WALTER_DOMAIN=

# ─── Timezone ────────────────────────────────────────────────────────────
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
WALTER_TIMEZONE=UTC

# ─── Analytics export (n8n integration) ─────────────────────────────────
# Set to n8n postiz-analytics-ingest workflow webhook URL.
# See: docs/operational/postiz-analytics-export.md
POSTIZ_WEBHOOK_URL=

# ─── X (Twitter) ─────────────────────────────────────────────────────────
# https://developer.twitter.com/ → app → OAuth 2.0
POSTIZ_X_API_KEY=
POSTIZ_X_API_SECRET=

# ─── LinkedIn ─────────────────────────────────────────────────────────────
# https://www.linkedin.com/developers/apps
POSTIZ_LINKEDIN_CLIENT_ID=
POSTIZ_LINKEDIN_CLIENT_SECRET=

# ─── Instagram (via Facebook Graph API) ──────────────────────────────────
# https://developers.facebook.com/apps
POSTIZ_INSTAGRAM_APP_ID=
POSTIZ_INSTAGRAM_APP_SECRET=

# ─── TikTok ───────────────────────────────────────────────────────────────
# https://developers.tiktok.com/apps
POSTIZ_TIKTOK_CLIENT_KEY=
POSTIZ_TIKTOK_CLIENT_SECRET=

# ─── YouTube Shorts (Google Cloud OAuth) ─────────────────────────────────
# https://console.cloud.google.com → YouTube Data API v3
POSTIZ_YOUTUBE_CLIENT_ID=
POSTIZ_YOUTUBE_CLIENT_SECRET=
