# Optional Renovate self-hosted runner settings.
#
# Copy to .env for non-secret settings only:
#   cp .env.template .env
#
# Do not place the bot token here. Store the token in Infisical as
# RENOVATE_TOKEN, then load it with walter_secrets_load or the walter-run
# wrapper before invoking docker compose.

# github for GitHub.com/GHES, forgejo for Walter-OS Forgejo.
RENOVATE_PLATFORM=github

# GitHub.com leaves this empty.
# Forgejo example: https://git.example.com/api/v1/
# GHES example: https://github-enterprise.example.com/api/v3/
RENOVATE_ENDPOINT=

# Comma-separated explicit repository list. Preferred for the first rollout.
# GitHub example: your-org/Walter-OS
# Forgejo example: walter/Walter-OS
RENOVATE_REPOSITORIES=

# Repository discovery is off by default. If enabled, also set a restrictive
# filter or namespace so the bot never runs across every repository it can see.
RENOVATE_AUTODISCOVER=false
RENOVATE_AUTODISCOVER_FILTER=
RENOVATE_AUTODISCOVER_NAMESPACES=

# Leave empty for real PR creation after dry-run verification.
# Set to full for validation.
RENOVATE_DRY_RUN=

RENOVATE_LOG_LEVEL=info
WALTER_TIMEZONE=UTC
