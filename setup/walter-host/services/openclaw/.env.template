# OpenClaw .env
# Phase 1: only Telegram bot.

# Public domain used by compose for allowed origins.
WALTER_DOMAIN=

# Optional override for the tunnel hostname used by deploy.sh, monitoring,
# and the OpenClaw browser allowed-origin config.
# Defaults to claw.${WALTER_DOMAIN}.
OPENCLAW_TUNNEL_HOSTNAME=

# OpenClaw Telegram bot (separate from alerting bot)
OPENCLAW_TELEGRAM_BOT_TOKEN=
OPENCLAW_OPERATOR_CHAT_ID=

# Virtual key from LiteLLM scoped to OpenClaw (Sonnet + fallback chain)
# Create in https://llm.${WALTER_DOMAIN} → Virtual Keys → openclaw-routine
LITELLM_OPENCLAW_KEY=

# Gateway auth token required for --bind lan.
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Optional model route. Must match a LiteLLM route name.
OPENCLAW_DEFAULT_MODEL=sonnet
