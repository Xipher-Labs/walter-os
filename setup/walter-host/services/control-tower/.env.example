# Control Tower service env — copy to .env and fill values from Infisical
# Never commit .env

LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=your-litellm-master-key

PLANE_API_URL=http://plane-web:3000
PLANE_API_TOKEN=your-plane-api-token
PLANE_WORKSPACE_SLUG=walter-os
PLANE_PROJECT_ID=your-project-uuid

GRAFANA_URL=http://grafana:3000
GRAFANA_SA_TOKEN=your-sa-token

# openssl rand -hex 32
CONTROL_TOWER_ADMIN_TOKEN=change-me
CONTROL_TOWER_AUTH_DISABLED=false

TAILSCALE_ENFORCE=true
TAILSCALE_CGNAT_CIDR=100.64.0.0/10
