# Metabase — environment template
# Harmonized from feat/social-pipeline branch (2026-05-12).
#
# Copy to .env and fill in real values before running docker compose up -d.
# Secret-of-truth: Infisical workspace=walter-os env=prod path=/services/metabase/

# ─── Generated secrets ────────────────────────────────────────────────────
# Fernet encryption key for saved database credentials in Metabase.
# Generate: openssl rand -base64 32 | tr -d '\n'
METABASE_ENCRYPTION_KEY=

# Postgres password for Metabase's own app DB.
# Generate: openssl rand -hex 16
METABASE_DB_PASS=

# Postgres password for the social analytics DB (written by n8n).
# Generate: openssl rand -hex 16
SOCIAL_PG_PASS=

# ─── Domain ───────────────────────────────────────────────────────────────
# Metabase served at https://metabase.${WALTER_DOMAIN}
WALTER_DOMAIN=

# ─── Timezone ─────────────────────────────────────────────────────────────
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
WALTER_TIMEZONE=UTC
