# Listmonk .env - copy to .env on Walter-VM and fill private values.

# Public base domain used by the documented Caddy route.
WALTER_DOMAIN=

# Optional timezone for container logs.
WALTER_TIMEZONE=UTC

# Required database password. Generate with: openssl rand -base64 32
LISTMONK_POSTGRES_PASSWORD=

# Required first-boot Super Admin credentials.
# Generate the password with: openssl rand -base64 32
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=
