# chatgpt-codex-router — environment template
# Set in /opt/walter-vm/services/chatgpt-codex-router/.env or pass via docker compose --env-file.

# [REQUIRED] API key for requests to this router.
# LiteLLM must supply: Authorization: Bearer <CCR_APIKEY>
# Generate: openssl rand -hex 32
CCR_APIKEY=

# [OPTIONAL] JSON object merged over the default request-alias -> Codex CLI slug map.
# Example: {"o4-mini":"gpt-5.5"}
MODEL_MAP_JSON=

# [OPTIONAL] Run real completion probes for every advertised model at startup.
# docker-compose enables this by default; set to 0 only for break-glass debugging.
ROUTER_STARTUP_MODEL_PROBE=1

# [OPTIONAL] Per-probe HTTP timeout in milliseconds.
ROUTER_STARTUP_MODEL_PROBE_TIMEOUT_MS=240000

# [OPTIONAL] Prompt sent by each startup model probe.
ROUTER_STARTUP_MODEL_PROBE_PROMPT="Reply with exactly: ok"
