# Langfuse optional profile environment.
# Copy to .env, generate every secret locally, then start with:
# docker compose --profile langfuse up -d

WALTER_DOMAIN=

# Required Langfuse application secrets.
# Generate NEXTAUTH_SECRET and SALT with: openssl rand -base64 32
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# Required service-local datastore credentials.
LANGFUSE_DB_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=

# Required service-local object storage credentials.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional runtime settings.
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_EMAIL_FROM_ADDRESS=
LANGFUSE_SMTP_CONNECTION_URL=

# Optional first-boot bootstrap.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
