# Infisical service-level secrets.
# Copy to /opt/walter-vm/services/infisical/.env on the VM (mode 600).
# Generate values once with: openssl rand -hex 16  /  openssl rand -base64 32
# DO NOT REGENERATE without restoring DB backup.

INFISICAL_ENCRYPTION_KEY=<openssl rand -hex 16>
INFISICAL_AUTH_SECRET=<openssl rand -base64 32>
INFISICAL_DB_PASS=<openssl rand -base64 24 | tr -d /+= | head -c 32>
INFISICAL_REDIS_PASS=<openssl rand -base64 24 | tr -d /+= | head -c 32>
