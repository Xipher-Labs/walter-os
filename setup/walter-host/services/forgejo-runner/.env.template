# Copy to .env and fill these values locally. Do not commit .env.

# Forgejo base URL reachable from the runner container.
FORGEJO_INSTANCE_URL=https://git.example.com

# Create this in Forgejo immediately before first registration. It is required
# only while /data/.runner is absent, then can be removed from .env.
# This is intentionally blank; it is a credential and must not be stored in git.
FORGEJO_RUNNER_REGISTRATION_TOKEN=

# Optional: keep one named runner per host so revocation is simple.
FORGEJO_RUNNER_NAME=walter-forgejo-runner-1

# Official Docker executor label form.
FORGEJO_RUNNER_LABELS=docker:docker://node:20-bullseye
