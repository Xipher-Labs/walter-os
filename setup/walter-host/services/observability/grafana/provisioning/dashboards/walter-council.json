{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Walter-VM Prometheus instance",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "uid": "walter-council",
  "title": "Walter Council",
  "description": "Walter Council v2 \u2014 agent observability dashboard. Tasks, tokens, agent state, approval-gate events, task duration (last).",
  "tags": [
    "walter-council",
    "agents"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Tasks / Day by Agent",
      "description": "Daily completed tasks broken down by agent. Counter resets on metrics file removal.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "xField": "Time",
        "barWidth": 0.97,
        "groupWidth": 0.7,
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "increase(walter_council_tasks_total[1d])",
          "legendFormat": "{{agent}} {{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens Consumed / Agent (stacked)",
      "description": "Cumulative token consumption by agent and model. Use rate() for per-second velocity.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "increase(walter_council_tokens_total[1h])",
          "legendFormat": "{{agent}} / {{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Task Success Rate (24h)",
      "description": "Percentage of tasks completed as done or review vs total tasks in the last 24h.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(walter_council_tasks_total{result=~\"success\"}[24h])) / clamp_min(sum(increase(walter_council_tasks_total[24h])), 1)",
          "legendFormat": "Success rate",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Approval-Gate Events Heatmap",
      "description": "Heatmap of approval-gate events by time and category. High density = frequent blocks.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 8
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "increase(walter_council_approvals_total[5m])",
          "legendFormat": "{{agent}} {{category}} {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Agent State",
      "description": "Current state of each council agent: 0=idle, 1=working, 2=blocked.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Agent",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "value": "0",
                    "result": {
                      "text": "idle",
                      "color": "green"
                    }
                  },
                  {
                    "type": "value",
                    "value": "1",
                    "result": {
                      "text": "working",
                      "color": "blue"
                    }
                  },
                  {
                    "type": "value",
                    "value": "2",
                    "result": {
                      "text": "blocked",
                      "color": "yellow"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "walter_council_agent_state",
          "legendFormat": "{{agent}}",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Task Duration (last) (seconds)",
      "description": "Last observed task duration per agent. High values may indicate slow models or runaway tasks.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "walter_council_task_duration_seconds",
          "legendFormat": "{{agent}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
