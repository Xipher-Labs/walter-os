{
  "uid": "walter-audit",
  "title": "Walter Audit Chain",
  "description": "Audit-chain telemetry from Promtail into Loki. Loki stores each JSONL row verbatim; panels parse JSON at query time.",
  "tags": [
    "walter-os",
    "audit",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Audit Rows / Second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(rate(({app=\"walter-os\", kind=\"audit-chain\"} | json | __error__=\"\")[5m]))",
          "legendFormat": "audit rows",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Block Rate by Decision Source",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (decision_source) (rate(({app=\"walter-os\", kind=\"audit-chain\"} | json | decision=\"block\" | __error__=\"\")[5m]))",
          "legendFormat": "{{decision_source}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Decisions by Type",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (decision) (count_over_time(({app=\"walter-os\", kind=\"audit-chain\"} | json | __error__=\"\")[$__range]))",
          "legendFormat": "{{decision}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Top Blocked Tools",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (tool) (count_over_time(({app=\"walter-os\", kind=\"audit-chain\"} | json | decision=\"block\" | __error__=\"\")[$__range])))",
          "legendFormat": "{{tool}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Top Block Reasons",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (decision_reason) (count_over_time(({app=\"walter-os\", kind=\"audit-chain\"} | json | decision=\"block\" | __error__=\"\")[$__range])))",
          "legendFormat": "{{decision_reason}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Distinct Sessions Seen",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "count(count by (session_id) (count_over_time(({app=\"walter-os\", kind=\"audit-chain\"} | json | session_id != \"\" | __error__=\"\")[$__range])))",
          "legendFormat": "sessions",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Recent Blocked Audit Rows",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 8,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{app=\"walter-os\", kind=\"audit-chain\"} | json | decision=\"block\" | __error__=\"\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
  "links": [
    {
      "title": "Loki Explore",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22queries%22%3A%5B%7B%22expr%22%3A%22%7Bapp%3D%5C%22walter-os%5C%22%2C%20kind%3D%5C%22audit-chain%5C%22%7D%20%7C%20json%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-24h%22%2C%22to%22%3A%22now%22%7D%7D"
    }
  ]
}
