# Walter-VM observability — copy to .env on the VM
# Generated values get pushed to Infisical (workspace=walter-vm-internal env=prod)

# Grafana admin (change password in UI after first login OR via env)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# Optional audit-chain telemetry override.
# Uncomment before running:
# docker compose -f compose.yml -f compose.audit.yml up -d
# WALTER_AUDIT_DIR=/home/walter/.config/walter-os/audit
# WALTER_AUDIT_HOST=walter-vm
