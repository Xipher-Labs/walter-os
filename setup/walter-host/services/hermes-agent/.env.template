# Hermes Agent .env
# See SUGGESTIONS.md for guidance on each group.

# ── Image build ────────────────────────────────────────────────────────────────
# Upstream Hermes image version. compose.yml uses this for the local
# walter-os image tag and Dockerfile metadata.
HERMES_AGENT_BASE_VERSION=v2026.5.7
# Full upstream image reference, including digest. Bump together with
# HERMES_AGENT_BASE_VERSION so the visible version and immutable content match.
HERMES_AGENT_BASE_IMAGE_REF=nousresearch/hermes-agent:v2026.5.7@sha256:9462082533e603fc6ba4259c51d7722dcd8cbb0f348488ceedc35d06fa8f9324

# ── LLM backend ──────────────────────────────────────────────────────────────
# Default: Walter-Bridge (LiteLLM). No changes needed if LiteLLM is running.
# To use a direct provider set HERMES_LLM_PROVIDER + the matching key below.
# Values: openai-compatible | openai | anthropic | nous-portal | openrouter
HERMES_LLM_PROVIDER=openai-compatible
LITELLM_BASE_URL=http://litellm:4000

# Virtual key from LiteLLM scoped to Hermes Agent
# Create in https://llm.${WALTER_DOMAIN} → Virtual Keys → hermes-agent
LITELLM_HERMES_KEY=

# ── API server ────────────────────────────────────────────────────────────────
# Expose Hermes as an OpenAI-compatible API (optional; off by default)
HERMES_API_SERVER_ENABLED=false
# Minimum 8 characters. Required if API_SERVER_ENABLED=true.
# Generate: openssl rand -hex 32
HERMES_API_SERVER_KEY=

# ── Skill-learning loop (Curator) ─────────────────────────────────────────────
# Curator autonomously manages Hermes skills in the background.
# OFF by default — enables only after reading SUGGESTIONS.md §5.
HERMES_CURATOR_ENABLED=false

# ── Platform integrations (all optional) ─────────────────────────────────────
# Telegram (primary — same as OpenClaw operator pattern)
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_OPERATOR_CHAT_ID=

# Discord (optional)
HERMES_DISCORD_BOT_TOKEN=
HERMES_DISCORD_GUILD_ID=

# Slack (optional)
HERMES_SLACK_BOT_TOKEN=
HERMES_SLACK_SIGNING_SECRET=

# ── Resource limits ───────────────────────────────────────────────────────────
# See SUGGESTIONS.md §6 for per-backend RAM/disk baselines.
# Cost cap (USD per day; 0 = unlimited)
HERMES_DAILY_COST_CAP_USD=0
# Max tokens per conversation turn (0 = provider default)
HERMES_MAX_TOKENS_PER_TURN=0
