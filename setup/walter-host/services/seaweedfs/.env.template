# SeaweedFS — environment template
# Vendored from operator VM container seaweedfs-main (2026-05-12).
#
# SeaweedFS 4.x runs without authentication by default when accessed via the
# S3 API. Any access key / secret key pair is accepted (the server does not
# validate credentials unless IAM is configured).
#
# To enable IAM (access key enforcement):
#   Add `-s3.config=/etc/weed/s3.json` to the command in compose.yml and
#   mount an IAM config file. See: https://github.com/seaweedfs/seaweedfs/wiki/Amazon-S3-API
#
# When PostHog uses SeaweedFS, it passes:
#   S3_ACCESS_KEY_ID: 'any'
#   S3_SECRET_ACCESS_KEY: 'any'
# (accepted by the unauthenticated default config)

# Container name (used by PostHog compose to reference the shared SeaweedFS instance)
SEAWEEDFS_DOCKER_NAME=seaweedfs-main
