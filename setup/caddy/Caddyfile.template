# Caddyfile.template — Walter-OS reverse proxy configuration
#
# This file uses ${VAR} syntax compatible with envsubst.
# The bootstrap script renders it: envsubst < Caddyfile.template > Caddyfile
#
# All services are on the walter_net Docker network and reachable
# by container name. Caddy is the only publicly-facing service.
#
# TLS: Automatic via ACME (Let's Encrypt or ZeroSSL). Ensure:
#   - Ports 80 and 443 are open on the host
#   - DNS A records for all subdomains point to this server
#   - Or use a wildcard DNS entry: *.${WALTER_DOMAIN} → server IP
#
# Tailscale note: if serving only on Tailscale, replace the site
# addresses with `https://<service>.${WALTER_DOMAIN}` and point
# Tailscale DNS to this host. ACME still works via HTTP-01 challenge
# if port 80 is reachable, or use DNS-01 challenge for internal-only.
#
# Refs: docs/specs/phase-w-1-docker-compose.md
# Refs: setup/SERVICES-INVENTORY.md

# ---------------------------------------------------------------------------
# Global options
# ---------------------------------------------------------------------------

{
  email ${WALTER_ADMIN_EMAIL}
  # Use staging ACME for testing — remove for production
  # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ---------------------------------------------------------------------------
# admin_auth_gate snippet — defense-in-depth for admin dashboards.
#
# Closes external review F2 (issue #116). Every admin-surface site
# imports this snippet; it returns 403 unless the request EITHER:
#   - originates from a Tailscale tailnet / LAN / loopback IP, OR
#   - carries a Cloudflare Access email header.
#
# A bug in any individual dashboard's per-app auth (Grafana, n8n,
# Plane, etc.) cannot expose admin access to the public internet —
# requests without one of the two auth signals are dropped at the
# proxy layer.
#
# Configurable via the operator's personal.env:
#   WALTER_TAILNET_CIDR  — defaults to Tailscale CGNAT (100.64.0.0/10)
#   WALTER_LAN_CIDR      — defaults to private 192.168.0.0/16
#
# Sites that are GENUINELY public (Matrix federation, PostHog event
# ingestion, etc.) deliberately DO NOT import this — they have their
# own auth model + are documented as public-facing.
# ---------------------------------------------------------------------------

(admin_auth_gate) {
  # Note: envsubst (used to render this template) does NOT expand
  # ${VAR:-default} bash-style defaults. We use Caddy's native {$VAR}
  # placeholder syntax instead — Caddy reads these env vars at config
  # load time. The bootstrap script (setup/walter-host/bootstrap.sh)
  # exports sensible defaults for WALTER_TAILNET_CIDR + WALTER_LAN_CIDR
  # before invoking envsubst, so a missing operator override falls
  # back to those defaults rather than rendering an empty CIDR list
  # (which would make the matcher useless).
  # Two ALLOW signals — request passes if EITHER holds:
  #   (A) remote_ip in tailnet / LAN / loopback ("internal"), OR
  #   (B) remote_ip in Cloudflare edge ranges AND request carries
  #       the CF Access email header.
  #
  # Closes Copilot R2 #130 R2.1: previously the header was the only
  # check for the CF path, which is spoofable by any public attacker.
  # Tying header acceptance to CF edge IPs prevents the spoof —
  # CF strips/overrides incoming CF-Access-* headers when it
  # terminates the request.
  #
  # The Cloudflare edge IPv4 + IPv6 ranges below are the published
  # list from cloudflare.com/ips/. Refresh quarterly per
  # skills/quarterly-upgrade-cadence.
  #
  # Deny-path implementation: rather than express the negation of
  # (A OR B) as a single matcher (Caddy makes that awkward), use two
  # `handle` blocks ordered so DENY cases respond 403 and ALLOW cases
  # fall through to the site's reverse_proxy.

  @deny_not_in_any_allowlist {
    not remote_ip {$WALTER_TAILNET_CIDR} {$WALTER_LAN_CIDR} 10.0.0.0/8 127.0.0.0/8 ::1 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
  }
  handle @deny_not_in_any_allowlist {
    respond "403 — admin endpoint: requires Tailscale tailnet or Cloudflare Access" 403 {
      close
    }
  }

  @deny_cf_edge_without_header {
    remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    not header CF-Access-Authenticated-User-Email *
  }
  handle @deny_cf_edge_without_header {
    respond "403 — CF edge IP without CF Access email header (configure CF Access app on this hostname)" 403 {
      close
    }
  }
  # Anything else falls through to the site's reverse_proxy — allowed.
}

# ---------------------------------------------------------------------------
# CORE SERVICES
# ---------------------------------------------------------------------------

# Plane — project management
plane.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy plane-proxy:80
}

# Forgejo — git hosting
git.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy forgejo:3000
}

# Infisical — secrets manager
secrets.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy infisical:8080
}

# LiteLLM — LLM gateway
llm.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy litellm:4000
}

# Grafana — dashboards
grafana.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy grafana:3000
}

# n8n — workflow automation
n8n.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy n8n:5678
}

# Uptime Kuma — uptime monitoring
status.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy uptime-kuma:3001
}

# Homepage — service dashboard
home.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy homepage:3000
}

# Syncthing — file sync web UI
sync.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy syncthing:8384
}

# Headscale — Tailscale control plane (Headscale API + Tailscale clients)
headscale.${WALTER_DOMAIN} {
  reverse_proxy headscale:8080
}

# Headscale Admin UI
headscale-admin.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy headscale-admin:80
}

# WireGuard web UI
vpn.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy wg-easy:51821
}

# Control Tower — Walter Council UI (Tailscale-only)
# NOTE: Access is enforced at the app layer (TAILSCALE_ENFORCE=true).
# For defence-in-depth, add a `remote_ip` matcher here or use Cloudflare Access.
tower.${WALTER_DOMAIN} {
  reverse_proxy control-tower:3000 {
    # Strip attacker-controlled IP headers; set from actual remote address only.
    # Prevents X-Forwarded-For spoofing that would break Tailscale IP enforcement.
    header_up -X-Forwarded-For
    header_up -X-Real-IP
    header_up -CF-Connecting-IP
    header_up X-Real-IP {remote_host}
  }
}

# PostHog — product analytics
posthog.${WALTER_DOMAIN} {
  reverse_proxy posthog:8000
}

# Postiz — social media scheduling (promoted from devrel profile in v0.2.0)
postiz.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy postiz:3000
}

# Metabase — analytics / BI dashboards (promoted from devrel profile in v0.2.0)
metabase.${WALTER_DOMAIN} {
  import admin_auth_gate
  reverse_proxy metabase:3000
}

