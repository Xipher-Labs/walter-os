# ~/.codex/config.toml
# Generated by Walter-OS install.sh. Header is from
# setup/codex-config.toml.example; the [mcp_servers.*] blocks below are
# auto-generated from mcp/servers.json by scripts/generate-mcp-configs.sh.
# Edit setup/codex-config.toml.example for non-MCP settings;
# edit mcp/servers.json for MCP servers; then ./install.sh --upgrade.

# ---------- model and inference ----------

# Default model for codex sessions. Override per-session with: codex --model X
model = "gpt-5.5"

# Reasoning depth: "low" | "medium" | "high"
# Use "high" for security review or complex refactor sessions; "medium" otherwise.
reasoning_effort = "medium"

# ---------- AGENTS.md discovery ----------

# Codex walks the directory tree from cwd → repo root, reading AGENTS.md at each
# level. Higher specificity wins. Walter-OS's global AGENTS.md is symlinked into
# ~/.codex/AGENTS.md by install.sh and read as the home-level fallback.

# Also accept Walter-OS's CLAUDE.md as a fallback so Codex can read repos that
# only have Claude-Code-style docs.
project_doc_fallback_filenames = ["CLAUDE.md", "COPILOT.md"]

# Cap the size of injected agent docs so a runaway file doesn't blow context.
project_doc_max_bytes = 32768

# ---------- approval policy ----------

# "on-request" | "never"
# Walter-OS recommends "on-request" globally so Codex decides when an
# operation needs operator approval. Older approval policy names are rejected
# by newer Codex releases.
approval_policy = "on-request"

# Sandbox mode for tool execution: "danger-full-access" | "workspace-write" |
# "read-only". Stay in "workspace-write" — keeps Codex out of $HOME outside
# the project.
sandbox_mode = "workspace-write"

# ---------- skills directory ----------

# Codex reads SKILL.md from this directory. Walter-OS install.sh symlinks
# every skill from walter-os/skills/ into here.
skills_dir = "~/.codex/skills"

# ---------- MCP servers ----------
# (everything below this header is auto-generated by install.sh)
