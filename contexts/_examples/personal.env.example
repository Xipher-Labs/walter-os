# ~/.config/walter-os/overlay/personal.env
#
# Operator-specific values that personalize this Walter-OS checkout.
# Loaded by install.sh and bin/walter-os before any other config.
# Sourced at: ~/.config/walter-os/overlay/personal.env
#
# Precedence (most-specific wins):
#   1. Env vars exported in your shell (immediate override)
#   2. ${PROJECT_ROOT}/.env.local (in-repo, gitignored, this checkout only)
#   3. ~/.config/walter-os/overlay/personal.env (out-of-repo, shared across checkouts)
#   4. ${PROJECT_ROOT}/.env.example defaults (generic placeholders)

# === DOMAIN ===
# Used in all *.${WALTER_DOMAIN} service URLs (tower, git, plane, llm, secrets, etc.)
WALTER_DOMAIN=example.com

# === GITHUB IDENTITY ===
# REQUIRED — operator's GitHub org or username (no default; scripts fail if unset)
# Used by: bin/walter, scripts/walter/subcommands/new-project.sh,
#          skills/hackathon-spinup, any script that creates GitHub repos.
WALTER_GITHUB_ORG=
GITHUB_USER=your-github-username
# Default: xipher-labs/walter-os. Override if you fork with a different name.
WALTER_OS_UPDATE_REPO=xipher-labs/walter-os
# Public canonical URL used in Control Tower badge + changelog links
NEXT_PUBLIC_WALTER_REPO_URL=https://github.com/xipher-labs/walter-os

# === WALTER-HOST DEPLOYMENT ===
# REQUIRED (for walter-host only) — Linux username on the walter-host VM/server
# Used by: setup/walter-host/bootstrap-vm.sh, lock-ssh.sh,
#          services/restic/restic-backup.sh, cron/crontab.d/watchdog
# Default: walter (the documented reference deployment username)
# Operators using a different username: override here and update scripts accordingly.
# Skip if you are using walter-os in client-only mode (no self-hosted VM).
WALTER_OPERATOR_USER=walter

# === COPYRIGHT / ATTRIBUTION (for forkers maintaining their own NOTICE) ===
WALTER_COPYRIGHT_HOLDER="Your Name"
WALTER_COPYRIGHT_YEAR=2026

# === SERVICE IDENTITY DEFAULTS ===
# Matrix/Synapse default user when deploy.sh prints onboarding hints
WALTER_MATRIX_USER=admin
# Operator email for ACME/Let's Encrypt + GitHub Codeowners (if used)
WALTER_OPERATOR_EMAIL=operator@example.com

# === OPTIONAL — operator override examples ===
# WALTER_MANUAL_PR_REMOTE_PATTERN=acme-corp
# WALTER_BLOCKED_PATHS='internal/secrets/*'
