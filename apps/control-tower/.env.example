# Walter Council Control Tower — environment variables
# Copy to .env.local and fill in real values (never commit .env.local)

# LiteLLM gateway
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=your-litellm-master-key
# Optional standby LiteLLM endpoint used by the HA status panel.
# Leave empty when you do not run a standby node.
LITELLM_STANDBY_URL=

# Plane
PLANE_API_URL=http://plane:8080
PLANE_API_TOKEN=your-plane-api-token
PLANE_WORKSPACE_SLUG=walter-os
PLANE_PROJECT_ID=your-project-id
NEXT_PUBLIC_PLANE_URL=http://plane:8080  # External URL for Plane (used in Agent Status Board issue links)

# Grafana
GRAFANA_URL=http://grafana:3000
GRAFANA_SA_TOKEN=your-grafana-service-account-token

# Control Tower admin auth (generate with: openssl rand -hex 32)
# Required in production. Browser login stores a derived HttpOnly cookie;
# script clients can send: Authorization: Bearer <CONTROL_TOWER_ADMIN_TOKEN>
CONTROL_TOWER_ADMIN_TOKEN=change-me-32-hex-chars
CONTROL_TOWER_AUTH_DISABLED=false

# Canonical public base URL — used to construct login redirect Location
# headers. The Next.js standalone server binds to HOSTNAME=0.0.0.0 so
# request.url reports `http://0.0.0.0:3000/...`, which the browser
# refuses to follow when it appears in a Location header.
# Set this to the externally-reachable origin in production. Without it,
# Control Tower falls back to X-Forwarded-Host (set by Cloudflare Tunnel
# and Tailscale Serve), but an explicit value is more robust and also
# closes an open-redirect risk if Control Tower is ever exposed without
# a trusted proxy. See apps/control-tower/lib/canonical-url.ts.
#   Example: CONTROL_TOWER_PUBLIC_URL=https://tower.xipherlabs.xyz
CONTROL_TOWER_PUBLIC_URL=

# Filesystem paths (docker mounts or local dev overrides)
# Defaults point to the standard walter-council paths
WALTER_COUNCIL_DATA_DIR=/var/lib/walter-council
WALTER_COUNCIL_LOG_DIR=/var/log/walter-council
WALTER_CONFIG_DIR=/root/.config/walter-os

# Tailscale CGNAT range for access enforcement
# Set to "disabled" to skip the IP check in local dev
TAILSCALE_ENFORCE=true
TAILSCALE_CGNAT_CIDR=100.64.0.0/10

# OSS / forker settings
# URL of the Walter-OS repository this instance was forked from.
# Used to build the changelog link in VersionBadge. Set this to YOUR
# fork's URL (or the upstream you track). If left unset, the update
# badge still renders but without a link target — the Control Tower
# does NOT ship a hardcoded org name in its source, so there is no
# silent default. Forkers MUST set this.
#   Example: NEXT_PUBLIC_WALTER_REPO_URL=https://github.com/your-org/walter-os
NEXT_PUBLIC_WALTER_REPO_URL=
